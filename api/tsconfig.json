{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"declaration": false,
		"sourceMap": false,
		"removeComments": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
