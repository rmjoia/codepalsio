{
	"compilerOptions": {
		"target": "ES2022",
		"module": "node16",
		"moduleResolution": "node16",
		"types": ["node"],
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"declaration": false,
		"sourceMap": false,
		"removeComments": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts", "**/*.fake.ts"]
}
