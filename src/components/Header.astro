---
// Auth state is resolved client-side via /.auth/me (static mode — no server request context)
---

<header
	class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md shadow-sm transition-all duration-300"
>
	<nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-3 sm:py-4 flex items-center justify-between gap-2">
		<a href="/" class="flex items-center gap-2 min-w-0">
			<img src="/codepals00.jpg" alt="CodePals Logo" class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg flex-shrink-0" />
			<span class="text-lg sm:text-xl font-bold text-slate-900 truncate">CodePals</span>
		</a>

		<!-- Desktop nav links -->
		<div class="hidden md:flex items-center gap-8">
			<a href="/#features" class="text-slate-600 hover:text-primary-500 transition-colors">Features</a>
			<a href="/#how-it-works" class="text-slate-600 hover:text-primary-500 transition-colors">How It Works</a>
			<a href="/#mission" class="text-slate-600 hover:text-primary-500 transition-colors">Mission</a>
			<a id="nav-find" href="/find" class="hidden text-slate-600 hover:text-primary-500 transition-colors">Find CodePals</a>
		</div>

		<!-- Desktop auth area (signed-out + signed-in) -->
		<div class="hidden md:flex items-center gap-4">
			<a
				id="sign-in-btn"
				href="/.auth/login/github"
				class="btn-primary flex items-center gap-2"
			>
				<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
					<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
				</svg>
				Sign In
			</a>

			<div class="relative hidden" id="user-menu-container">
				<button
					id="user-menu-button"
					class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors"
					aria-label="User menu"
					aria-expanded="false"
				>
					<img id="user-avatar" src="" alt="Avatar" class="w-8 h-8 rounded-full hidden" />
					<div id="user-avatar-fallback" class="w-8 h-8 rounded-full bg-primary-500 text-white flex items-center justify-center font-semibold text-sm">?</div>
					<span id="user-display-name" class="text-slate-900 font-medium"></span>
					<svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</button>

				<div
					id="user-menu-dropdown"
					class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-2xl border border-slate-200 py-2 z-50"
				>
					<div class="px-4 py-3 border-b border-slate-200">
						<p id="dropdown-username" class="text-sm font-semibold text-slate-900"></p>
						<p class="text-xs text-slate-500">Signed in with GitHub</p>
					</div>

					<a href="/profile" class="flex items-center gap-3 px-4 py-2 hover:bg-slate-50 transition-colors text-slate-700">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
						</svg>
						My Profile
					</a>

					<a href="/find" class="flex items-center gap-3 px-4 py-2 hover:bg-slate-50 transition-colors text-slate-700">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
						</svg>
						Find CodePals
					</a>

					<a id="admin-link" href="/admin" class="hidden flex items-center gap-3 px-4 py-2 hover:bg-slate-50 transition-colors text-slate-700">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
						</svg>
						Admin
					</a>

					<div class="border-t border-slate-200 my-2"></div>

					<button
						id="delete-account-btn"
						class="flex items-center gap-3 px-4 py-2 hover:bg-red-50 transition-colors text-red-600 w-full text-left"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
						</svg>
						Delete Account
					</button>

					<div class="border-t border-slate-200 my-2"></div>

					<a href="/.auth/logout" class="flex items-center gap-3 px-4 py-2 hover:bg-slate-50 transition-colors text-slate-700">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
						</svg>
						Sign Out
					</a>
				</div>
			</div>
		</div>

		<!-- Mobile hamburger -->
		<button
			id="mobile-menu-button"
			class="md:hidden p-2 -mr-2 rounded-lg hover:bg-slate-100 transition-colors"
			aria-label="Toggle menu"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<svg id="mobile-menu-icon-open" class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
			<svg id="mobile-menu-icon-close" class="hidden w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</nav>

	<!-- Mobile menu panel -->
	<div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 py-3 flex flex-col">
			<!-- Identity row (signed-in only) -->
			<div id="mobile-user-info" class="hidden flex items-center gap-3 px-2 py-3 border-b border-slate-200 mb-2">
				<img id="mobile-user-avatar" src="" alt="Avatar" class="w-10 h-10 rounded-full hidden" />
				<div id="mobile-user-avatar-fallback" class="w-10 h-10 rounded-full bg-primary-500 text-white flex items-center justify-center font-semibold">?</div>
				<div class="min-w-0">
					<p id="mobile-username" class="text-sm font-semibold text-slate-900 truncate"></p>
					<p class="text-xs text-slate-500">Signed in with GitHub</p>
				</div>
			</div>

			<!-- Nav links (always visible) -->
			<a href="/#features" class="block px-2 py-3 text-slate-700 hover:bg-slate-50 rounded-md transition-colors">Features</a>
			<a href="/#how-it-works" class="block px-2 py-3 text-slate-700 hover:bg-slate-50 rounded-md transition-colors">How It Works</a>
			<a href="/#mission" class="block px-2 py-3 text-slate-700 hover:bg-slate-50 rounded-md transition-colors">Mission</a>
			<a id="mobile-nav-find" href="/find" class="hidden px-2 py-3 text-slate-700 hover:bg-slate-50 rounded-md transition-colors">Find CodePals</a>

			<!-- Signed-in actions -->
			<div id="mobile-signed-in-actions" class="hidden flex flex-col border-t border-slate-200 mt-2 pt-2">
				<a href="/profile" class="block px-2 py-3 text-slate-700 hover:bg-slate-50 rounded-md transition-colors">My Profile</a>
				<a id="mobile-admin-link" href="/admin" class="hidden px-2 py-3 text-slate-700 hover:bg-slate-50 rounded-md transition-colors">Admin</a>
				<button id="mobile-delete-account-btn" class="text-left px-2 py-3 text-red-600 hover:bg-red-50 rounded-md transition-colors w-full">
					Delete Account
				</button>
				<a href="/.auth/logout" class="block px-2 py-3 text-slate-700 hover:bg-slate-50 rounded-md transition-colors">Sign Out</a>
			</div>

			<!-- Signed-out CTA -->
			<a id="mobile-sign-in-btn" href="/.auth/login/github" class="mt-3 inline-flex items-center justify-center gap-2 w-full px-4 py-3 bg-primary-500 text-white rounded-lg font-semibold hover:bg-primary-600 transition-colors">
				<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
					<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
				</svg>
				Sign in with GitHub
			</a>
		</div>
	</div>
</header>

<script>
	import { getPrincipal, getAvatarUrl, hasRole, deleteAccount } from '../services/api';

	(async () => {
		const principal = await getPrincipal();
		if (!principal) return;

		const username = principal.userDetails || 'User';
		const avatarUrl = getAvatarUrl(principal);
		const isAdmin = hasRole(principal, 'admin');

		// === Desktop ===
		document.getElementById('sign-in-btn')?.classList.add('hidden');
		document.getElementById('user-menu-container')?.classList.remove('hidden');
		document.getElementById('nav-find')?.classList.remove('hidden');

		const desktopAvatar = document.getElementById('user-avatar') as HTMLImageElement | null;
		if (avatarUrl && desktopAvatar) {
			desktopAvatar.src = avatarUrl;
			desktopAvatar.alt = username;
			desktopAvatar.classList.remove('hidden');
			document.getElementById('user-avatar-fallback')?.classList.add('hidden');
		} else {
			const fallback = document.getElementById('user-avatar-fallback');
			if (fallback) fallback.textContent = username.charAt(0).toUpperCase();
		}

		const desktopName = document.getElementById('user-display-name');
		if (desktopName) desktopName.textContent = '@' + username;
		const dropdownUsername = document.getElementById('dropdown-username');
		if (dropdownUsername) dropdownUsername.textContent = '@' + username;

		if (isAdmin) document.getElementById('admin-link')?.classList.remove('hidden');

		// === Mobile ===
		// `mobile-user-info` and `mobile-signed-in-actions` already have `flex`
		// in their static class list alongside `hidden` — Tailwind's `hidden`
		// wins until removed, so dropping `hidden` is all that's needed.
		const mobileSignIn = document.getElementById('mobile-sign-in-btn');
		const mobileUserInfo = document.getElementById('mobile-user-info');
		const mobileSignedInActions = document.getElementById('mobile-signed-in-actions');
		const mobileNavFind = document.getElementById('mobile-nav-find');

		mobileSignIn?.classList.add('hidden');
		mobileUserInfo?.classList.remove('hidden');
		mobileSignedInActions?.classList.remove('hidden');
		mobileNavFind?.classList.remove('hidden');

		const mobileAvatar = document.getElementById('mobile-user-avatar') as HTMLImageElement | null;
		if (avatarUrl && mobileAvatar) {
			mobileAvatar.src = avatarUrl;
			mobileAvatar.alt = username;
			mobileAvatar.classList.remove('hidden');
			document.getElementById('mobile-user-avatar-fallback')?.classList.add('hidden');
		} else {
			const fb = document.getElementById('mobile-user-avatar-fallback');
			if (fb) fb.textContent = username.charAt(0).toUpperCase();
		}

		const mobileName = document.getElementById('mobile-username');
		if (mobileName) mobileName.textContent = '@' + username;

		if (isAdmin) document.getElementById('mobile-admin-link')?.classList.remove('hidden');
	})();

	// Account deletion (wired for both desktop + mobile buttons).
	async function handleDelete() {
		if (!confirm('Are you sure you want to delete your account? This action cannot be undone.')) return;
		try {
			await deleteAccount();
			window.location.href = '/?message=account_deleted';
		} catch {
			alert('Deletion failed');
		}
	}
	document.getElementById('delete-account-btn')?.addEventListener('click', handleDelete);
	document.getElementById('mobile-delete-account-btn')?.addEventListener('click', handleDelete);

	// === Desktop user dropdown ===
	const menuButton = document.getElementById('user-menu-button');
	const menuDropdown = document.getElementById('user-menu-dropdown');

	if (menuButton && menuDropdown) {
		menuButton.addEventListener('click', (e) => {
			e.stopPropagation();
			menuDropdown.classList.toggle('hidden');
			menuButton.setAttribute('aria-expanded', menuDropdown.classList.contains('hidden') ? 'false' : 'true');
		});

		document.addEventListener('click', (e) => {
			const target = e.target;
			if (!(target instanceof Node)) return;
			if (!menuButton.contains(target) && !menuDropdown.contains(target)) {
				menuDropdown.classList.add('hidden');
				menuButton.setAttribute('aria-expanded', 'false');
			}
		});
	}

	// === Mobile menu ===
	const mobileBtn = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');
	const iconOpen = document.getElementById('mobile-menu-icon-open');
	const iconClose = document.getElementById('mobile-menu-icon-close');

	function setMobileMenuOpen(open: boolean) {
		if (!mobileMenu || !mobileBtn) return;
		mobileMenu.classList.toggle('hidden', !open);
		mobileBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
		iconOpen?.classList.toggle('hidden', open);
		iconClose?.classList.toggle('hidden', !open);
	}

	if (mobileBtn && mobileMenu) {
		mobileBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			setMobileMenuOpen(mobileMenu.classList.contains('hidden'));
		});

		// Close on tap outside
		document.addEventListener('click', (e) => {
			const target = e.target;
			if (!(target instanceof Node)) return;
			if (!mobileMenu.contains(target) && !mobileBtn.contains(target)) {
				setMobileMenuOpen(false);
			}
		});

		// Close when a link inside the panel is tapped (so navigation feels right)
		mobileMenu.querySelectorAll('a').forEach((a) => {
			a.addEventListener('click', () => setMobileMenuOpen(false));
		});

		// Close if viewport widens past md (panel is md:hidden so it'd be invisible anyway,
		// but the aria-expanded state should match)
		const mql = window.matchMedia('(min-width: 768px)');
		mql.addEventListener('change', (ev) => {
			if (ev.matches) setMobileMenuOpen(false);
		});
	}

	// Escape closes whichever popup is open
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		if (menuDropdown && !menuDropdown.classList.contains('hidden')) {
			menuDropdown.classList.add('hidden');
			menuButton?.setAttribute('aria-expanded', 'false');
		}
		if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
			setMobileMenuOpen(false);
		}
	});
</script>
