---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#00bcd4" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<SEO
			title="Account suspended | CodePals"
			description="Your CodePals account has been suspended. See how to appeal."
			canonical="/suspended"
			noindex={true}
		/>
	</head>
	<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen flex flex-col">
		<Header />

		<main class="flex-1 mx-auto max-w-2xl w-full px-4 py-16 text-center">
			<div class="text-6xl mb-4">🚫</div>
			<h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">Your account is suspended</h1>
			<p class="text-slate-600 mb-8">
				A CodePals moderator has suspended this account for conduct that violates our Terms of Use
				or Code of Conduct. While suspended you can't post, edit your profile, report other users,
				or appear in the public directory.
			</p>

			<div
				class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 text-left text-sm text-slate-700 mb-8"
			>
				<p class="font-semibold text-slate-900 mb-2">Appealing a suspension</p>
				<p class="mb-3">
					If you believe this was a mistake, email
					<a
						href="mailto:abuse@codepals.io?subject=Suspension%20appeal"
						class="text-primary-600 hover:text-primary-700 hover:underline">abuse@codepals.io</a
					>
					from the address on file for your GitHub account. Include your GitHub username and a brief explanation.
					We respond within five business days.
				</p>
				<p class="text-slate-600">
					You can still browse CodePals signed out — only authenticated features are blocked.
				</p>
			</div>

			<div class="flex flex-wrap gap-3 justify-center">
				<a
					href="/logout"
					class="px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
				>
					Sign out
				</a>
				<a
					href="/terms"
					class="px-4 py-2 bg-white text-slate-700 border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
				>
					Read the Terms
				</a>
			</div>
		</main>

		<Footer />
	</body>
</html>
