---
// Stub page that redirects to /profile?edit=true. Astro.redirect() isn't
// available in static mode, so we use a meta-refresh — works without JS,
// stays valid under strict CSP.
---
<!DOCTYPE html>
<html>
	<head>
		<meta http-equiv="refresh" content="0;url=/profile?edit=true" />
		<title>Redirecting…</title>
	</head>
	<body>
		<noscript>
			Redirecting to <a href="/profile?edit=true">profile editor</a>.
		</noscript>
	</body>
</html>
