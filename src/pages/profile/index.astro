---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEO from '../../components/SEO.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#00bcd4" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<SEO
			title="My Profile — CodePals"
			description="Your CodePals profile. Edit your bio, skills, interests, and visibility settings."
			canonical="/profile"
			noindex={true}
		/>
	</head>
	<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
		<Header />

		<!-- Loading state -->
		<div id="loading-state" class="flex justify-center items-center min-h-[60vh]">
			<div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-500"></div>
		</div>

		<!-- Error state -->
		<div id="error-state" class="hidden mx-auto max-w-2xl px-4 py-16 text-center">
			<h1 class="text-2xl font-bold text-red-700 mb-2">Couldn't load your profile</h1>
			<p class="text-slate-600 mb-6">
				Something went wrong. Please refresh the page and try again.
			</p>
			<button
				id="error-refresh-btn"
				class="px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
			>
				Refresh
			</button>
		</div>

		<main id="profile-main" class="hidden mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
			<!-- User header card -->
			<div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
				<div class="flex items-start justify-between gap-6">
					<div class="flex items-start gap-6">
						<img
							id="profile-avatar"
							src=""
							alt="Avatar"
							class="w-24 h-24 rounded-full border-4 border-primary-100"
						/>
						<div class="flex-1">
							<h1 id="username-display" class="text-3xl font-bold text-slate-900 mb-2"></h1>
							<p class="text-slate-600 mb-2">CodePals Member</p>
							<span
								id="visibility-badge"
								class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full"
							></span>
						</div>
					</div>
					<button
						id="edit-btn"
						class="px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors flex items-center gap-2"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
							></path>
						</svg>
						Edit Profile
					</button>
					<button
						id="cancel-btn"
						class="hidden px-4 py-2 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors"
					>
						Cancel
					</button>
				</div>
			</div>

			<!-- View mode -->
			<div id="view-mode">
				<!--
					Moderator-action banner (spec 003 US3). Shown when the loaded
					profile has `unlistedBy` set — the profile was removed from
					public discovery by a moderator, not by the owner. Takes
					precedence over the incomplete banner because the user needs
					to know the state before being nudged to add fields.
					Issue #85.
				-->
				<div
					id="unlisted-banner"
					class="hidden bg-red-50 border border-red-200 rounded-xl p-6 mb-8"
				>
					<div class="flex items-start gap-4">
						<svg
							class="w-6 h-6 text-red-600 flex-shrink-0 mt-0.5"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
							></path>
						</svg>
						<div>
							<h3 class="font-semibold text-red-900 mb-1">Profile unlisted by a moderator</h3>
							<p class="text-red-800 text-sm mb-3">
								Your profile has been removed from public discovery (<code>/find</code>) by a
								moderator. This usually means a report flagged a Terms of Service violation. See
								<a
									href="/terms"
									target="_blank"
									rel="noopener noreferrer"
									class="underline hover:text-red-900">Terms § 9</a
								>. If you think this is a mistake, email
								<a href="mailto:abuse@codepals.io" class="underline hover:text-red-900"
									>abuse@codepals.io</a
								>
								— a moderator will review.
							</p>
							<p class="text-red-700 text-xs italic">
								The profile-visibility toggle is disabled until a moderator relists your profile.
							</p>
						</div>
					</div>
				</div>

				<!-- Incomplete profile banner -->
				<div
					id="incomplete-banner"
					class="hidden bg-amber-50 border border-amber-200 rounded-xl p-6 mb-8"
				>
					<div class="flex items-start gap-4">
						<svg
							class="w-6 h-6 text-amber-600 flex-shrink-0 mt-0.5"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<div>
							<h3 class="font-semibold text-amber-900 mb-1">Complete your public profile</h3>
							<p id="incomplete-banner-copy" class="text-amber-800 text-sm mb-3">
								A few things still need filling before other CodePals can find and connect with you.
							</p>
							<ul
								id="incomplete-banner-missing"
								class="text-amber-800 text-sm mb-3 list-disc list-inside space-y-1"
							>
							</ul>
							<button
								id="complete-profile-btn"
								class="text-sm font-medium text-amber-700 hover:text-amber-800 underline"
							>
								Complete your profile →
							</button>
						</div>
					</div>
				</div>

				<div class="space-y-6">
					<div class="bg-white rounded-xl shadow p-6">
						<h2 class="text-xl font-bold text-slate-900 mb-4">About Me</h2>
						<p id="profile-bio" class="text-slate-700 whitespace-pre-wrap hidden"></p>
						<p id="profile-bio-empty" class="text-slate-600 italic hidden">
							No bio added yet. Click "Edit Profile" to add one.
						</p>
					</div>

					<div class="bg-white rounded-xl shadow p-6">
						<h2 class="text-xl font-bold text-slate-900 mb-4">Skills</h2>
						<div id="profile-skills" class="flex flex-wrap gap-2 hidden"></div>
						<p id="profile-skills-empty" class="text-slate-600 italic hidden">
							No skills added yet. Click "Edit Profile" to add some.
						</p>
					</div>

					<div class="bg-white rounded-xl shadow p-6">
						<h2 class="text-xl font-bold text-slate-900 mb-4">Interests</h2>
						<div id="profile-interests" class="flex flex-wrap gap-2 hidden"></div>
						<p id="profile-interests-empty" class="text-slate-600 italic hidden">
							No interests added yet. Click "Edit Profile" to add some.
						</p>
					</div>

					<div class="bg-white rounded-xl shadow p-6">
						<h2 class="text-xl font-bold text-slate-900 mb-4">Languages I speak</h2>
						<div id="profile-languages" class="flex flex-wrap gap-2 hidden"></div>
						<p id="profile-languages-empty" class="text-slate-600 italic hidden">
							No languages added yet. Click "Edit Profile" to add some.
						</p>
					</div>

					<div id="profile-details-card" class="hidden bg-white rounded-xl shadow p-6">
						<h2 class="text-xl font-bold text-slate-900 mb-4">Details</h2>
						<div class="space-y-2">
							<p id="detail-location" class="hidden text-slate-700"></p>
							<p id="detail-timezone" class="hidden text-slate-700"></p>
							<p id="detail-availability" class="hidden text-slate-700"></p>
						</div>
					</div>
				</div>
			</div>

			<!-- Edit mode (hidden by default) -->
			<div id="edit-mode" class="hidden bg-white rounded-2xl shadow-lg p-8">
				<h2 class="text-2xl font-bold text-slate-900 mb-6">Edit Your Profile</h2>

				<form id="profile-form" class="space-y-6">
					<div>
						<label for="displayName" class="block text-sm font-semibold text-slate-900 mb-2">
							Display Name *
						</label>
						<input
							type="text"
							id="displayName"
							name="displayName"
							required
							placeholder="How should we call you?"
							class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
						/>
					</div>

					<div>
						<label for="bio" class="block text-sm font-semibold text-slate-900 mb-2"> Bio * </label>
						<textarea
							id="bio"
							name="bio"
							required
							rows="4"
							maxlength="500"
							placeholder="Tell us about yourself, your interests, and what you're looking for in a CodePal..."
							class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
						></textarea>
						<p class="mt-1 text-sm text-slate-500">
							<span id="bio-count">0</span>/500 characters (minimum 50)
						</p>
					</div>

					<fieldset class="border-0 p-0 m-0">
						<legend class="block text-sm font-semibold text-slate-900 mb-2">
							Skills * (at least 2)
						</legend>
						<input
							type="text"
							id="skills-input"
							placeholder="Type a skill and press Enter to add (e.g., C#, JavaScript, Python)"
							class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
						/>
						<p class="mt-1 text-sm text-slate-500">
							Type each skill and press <kbd class="px-2 py-0.5 bg-slate-200 rounded text-xs"
								>Enter</kbd
							> or <kbd class="px-2 py-0.5 bg-slate-200 rounded text-xs">comma</kbd> to add it
						</p>
						<div id="skills-container" class="flex flex-wrap gap-2 mt-3 min-h-[40px]"></div>
					</fieldset>

					<fieldset class="border-0 p-0 m-0">
						<legend class="block text-sm font-semibold text-slate-900 mb-2">
							Interests * (at least 2)
						</legend>
						<input
							type="text"
							id="interests-input"
							placeholder="Type an interest and press Enter to add (e.g., Web Development, AI)"
							class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
						/>
						<p class="mt-1 text-sm text-slate-500">
							Type each interest and press <kbd class="px-2 py-0.5 bg-slate-200 rounded text-xs"
								>Enter</kbd
							> or <kbd class="px-2 py-0.5 bg-slate-200 rounded text-xs">comma</kbd> to add it
						</p>
						<div id="interests-container" class="flex flex-wrap gap-2 mt-3 min-h-[40px]"></div>
					</fieldset>

					<fieldset class="border-0 p-0 m-0">
						<legend class="block text-sm font-semibold text-slate-900 mb-2">
							Languages I speak
						</legend>
						<input
							type="text"
							id="languages-input"
							placeholder="Type a language and press Enter to add (e.g., English, Português)"
							class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
						/>
						<p class="mt-1 text-sm text-slate-500">
							Optional — helps non-English-speaking CodePals find you. Type each language and press
							<kbd class="px-2 py-0.5 bg-slate-200 rounded text-xs">Enter</kbd> or
							<kbd class="px-2 py-0.5 bg-slate-200 rounded text-xs">comma</kbd> to add it.
						</p>
						<div id="languages-container" class="flex flex-wrap gap-2 mt-3 min-h-[40px]"></div>
					</fieldset>

					<div class="grid md:grid-cols-2 gap-6">
						<div>
							<label for="location" class="block text-sm font-semibold text-slate-900 mb-2"
								>Location</label
							>
							<input
								type="text"
								id="location"
								name="location"
								placeholder="e.g., Dublin, Ireland"
								class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
							/>
						</div>
						<div>
							<label for="timezone" class="block text-sm font-semibold text-slate-900 mb-2"
								>Timezone</label
							>
							<input
								type="text"
								id="timezone"
								name="timezone"
								list="timezone-options"
								autocomplete="off"
								placeholder="Start typing — e.g. Europe/Dublin, America/New_York"
								class="tz-input w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
							/>
							<datalist id="timezone-options"></datalist>
							<p class="mt-1 text-xs text-slate-500">
								IANA timezone (e.g. <code>Europe/Lisbon</code>, <code>Pacific/Honolulu</code>,
								<code>Africa/Lagos</code>). Start typing to see suggestions.
							</p>
						</div>
					</div>

					<div class="grid md:grid-cols-2 gap-6">
						<div>
							<label
								for="years-of-experience"
								class="block text-sm font-semibold text-slate-900 mb-2">Years of experience</label
							>
							<input
								type="number"
								id="years-of-experience"
								name="yearsOfExperience"
								min="0"
								max="60"
								step="1"
								placeholder="e.g., 5"
								class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
							/>
						</div>
					</div>

					<fieldset class="border-0 p-0 m-0">
						<legend class="block text-sm font-semibold text-slate-900 mb-2">Links</legend>
						<p class="text-sm text-slate-500 mb-3">
							All optional. URLs must start with <code class="text-xs">https://</code> — anything else
							is rejected by the server and dropped silently.
						</p>
						<div class="space-y-3">
							<div>
								<label for="githubUrl" class="block text-xs font-medium text-slate-700 mb-1"
									>GitHub profile URL</label
								>
								<input
									type="url"
									id="githubUrl"
									name="githubUrl"
									placeholder="https://github.com/yourhandle"
									pattern="https://.*"
									class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
								/>
							</div>
							<div>
								<label for="linkedinUrl" class="block text-xs font-medium text-slate-700 mb-1"
									>LinkedIn profile URL</label
								>
								<input
									type="url"
									id="linkedinUrl"
									name="linkedinUrl"
									placeholder="https://linkedin.com/in/yourhandle"
									pattern="https://.*"
									class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
								/>
							</div>
							<div>
								<label for="websiteUrl" class="block text-xs font-medium text-slate-700 mb-1"
									>Personal website</label
								>
								<input
									type="url"
									id="websiteUrl"
									name="websiteUrl"
									placeholder="https://yoursite.dev"
									pattern="https://.*"
									class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
								/>
							</div>
						</div>
					</fieldset>

					<fieldset class="border-0 p-0 m-0">
						<legend class="block text-sm font-semibold text-slate-900 mb-2">Availability</legend>
						<div class="space-y-2">
							<label class="flex items-center gap-2">
								<input
									type="radio"
									name="availability"
									value="active"
									class="text-primary-500"
									checked
								/>
								<span class="text-slate-700">Active - Looking for a CodePal</span>
							</label>
							<label class="flex items-center gap-2">
								<input type="radio" name="availability" value="casual" class="text-primary-500" />
								<span class="text-slate-700">Casual - Open to occasional connections</span>
							</label>
							<label class="flex items-center gap-2">
								<input
									type="radio"
									name="availability"
									value="unavailable"
									class="text-primary-500"
								/>
								<span class="text-slate-700">Not available right now</span>
							</label>
						</div>
					</fieldset>

					<fieldset class="border-0 p-0 m-0">
						<legend class="block text-sm font-semibold text-slate-900 mb-2"
							>Profile Visibility</legend
						>
						<p class="text-sm text-slate-500 mb-3">
							Control whether your profile shows up in the public CodePals directory at <code
								class="text-xs">/find</code
							>. You can flip this any time.
						</p>
						<div class="space-y-2">
							<label class="flex items-center gap-2">
								<input
									type="radio"
									name="profileVisibility"
									value="private"
									class="text-primary-500"
									checked
								/>
								<span class="text-slate-700">Private - Only you see your profile</span>
							</label>
							<label class="flex items-center gap-2">
								<input
									type="radio"
									name="profileVisibility"
									value="public"
									class="text-primary-500"
								/>
								<span class="text-slate-700">Public - Listed in the CodePals directory</span>
							</label>
						</div>
					</fieldset>

					<!--
						Per-field audience. Defaults are public for every field; this
						section only matters when the profile itself is public. Identity
						fields (display name, GitHub handle, availability) are not
						hideable — the directory card needs them to identify itself.
						Backend whitelist (HIDEABLE_FIELDS) is the security boundary;
						this UI is purely a control panel.
					-->
					<fieldset id="field-visibility-section" class="border-0 p-0 m-0">
						<legend class="block text-sm font-semibold text-slate-900 mb-2">
							Per-field audience
						</legend>
						<p class="text-sm text-slate-500 mb-3">
							Fine-tune who sees each field once your profile is Public. <span
								class="font-medium text-slate-700">Public</span
							> is everyone, <span class="font-medium text-slate-700">CodePals only</span> is signed-in
							viewers, <span class="font-medium text-slate-700">Only me</span> is owner-only.
						</p>
						<div class="space-y-3">
							<div class="flex items-center justify-between gap-3">
								<label for="field-vis-bio" class="text-sm text-slate-700 flex-shrink-0 w-28 sm:w-32"
									>Bio</label
								>
								<select
									id="field-vis-bio"
									data-field="bio"
									class="field-visibility-select flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
								>
									<option value="public">Public — everyone</option>
									<option value="authenticated">CodePals only — signed-in</option>
									<option value="private">Only me</option>
								</select>
							</div>
							<div class="flex items-center justify-between gap-3">
								<label
									for="field-vis-skills"
									class="text-sm text-slate-700 flex-shrink-0 w-28 sm:w-32">Skills</label
								>
								<select
									id="field-vis-skills"
									data-field="skills"
									class="field-visibility-select flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
								>
									<option value="public">Public — everyone</option>
									<option value="authenticated">CodePals only — signed-in</option>
									<option value="private">Only me</option>
								</select>
							</div>
							<div class="flex items-center justify-between gap-3">
								<label
									for="field-vis-interests"
									class="text-sm text-slate-700 flex-shrink-0 w-28 sm:w-32">Interests</label
								>
								<select
									id="field-vis-interests"
									data-field="interests"
									class="field-visibility-select flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
								>
									<option value="public">Public — everyone</option>
									<option value="authenticated">CodePals only — signed-in</option>
									<option value="private">Only me</option>
								</select>
							</div>
							<div class="flex items-center justify-between gap-3">
								<label
									for="field-vis-location"
									class="text-sm text-slate-700 flex-shrink-0 w-28 sm:w-32">Location</label
								>
								<select
									id="field-vis-location"
									data-field="location"
									class="field-visibility-select flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
								>
									<option value="public">Public — everyone</option>
									<option value="authenticated">CodePals only — signed-in</option>
									<option value="private">Only me</option>
								</select>
							</div>
							<div class="flex items-center justify-between gap-3">
								<label
									for="field-vis-timezone"
									class="text-sm text-slate-700 flex-shrink-0 w-28 sm:w-32">Timezone</label
								>
								<select
									id="field-vis-timezone"
									data-field="timezone"
									class="field-visibility-select flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
								>
									<option value="public">Public — everyone</option>
									<option value="authenticated">CodePals only — signed-in</option>
									<option value="private">Only me</option>
								</select>
							</div>
							<div class="flex items-center justify-between gap-3">
								<label
									for="field-vis-preferredLanguages"
									class="text-sm text-slate-700 flex-shrink-0 w-28 sm:w-32">Languages</label
								>
								<select
									id="field-vis-preferredLanguages"
									data-field="preferredLanguages"
									class="field-visibility-select flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
								>
									<option value="public">Public — everyone</option>
									<option value="authenticated">CodePals only — signed-in</option>
									<option value="private">Only me</option>
								</select>
							</div>
							<div class="flex items-center justify-between gap-3">
								<label
									for="field-vis-yearsOfExperience"
									class="text-sm text-slate-700 flex-shrink-0 w-28 sm:w-32">Experience</label
								>
								<select
									id="field-vis-yearsOfExperience"
									data-field="yearsOfExperience"
									class="field-visibility-select flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
								>
									<option value="public">Public — everyone</option>
									<option value="authenticated">CodePals only — signed-in</option>
									<option value="private">Only me</option>
								</select>
							</div>
							<div class="flex items-center justify-between gap-3">
								<label
									for="field-vis-githubUrl"
									class="text-sm text-slate-700 flex-shrink-0 w-28 sm:w-32">GitHub URL</label
								>
								<select
									id="field-vis-githubUrl"
									data-field="githubUrl"
									class="field-visibility-select flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
								>
									<option value="public">Public — everyone</option>
									<option value="authenticated">CodePals only — signed-in</option>
									<option value="private">Only me</option>
								</select>
							</div>
							<div class="flex items-center justify-between gap-3">
								<label
									for="field-vis-linkedinUrl"
									class="text-sm text-slate-700 flex-shrink-0 w-28 sm:w-32">LinkedIn URL</label
								>
								<select
									id="field-vis-linkedinUrl"
									data-field="linkedinUrl"
									class="field-visibility-select flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
								>
									<option value="public">Public — everyone</option>
									<option value="authenticated">CodePals only — signed-in</option>
									<option value="private">Only me</option>
								</select>
							</div>
							<div class="flex items-center justify-between gap-3">
								<label
									for="field-vis-websiteUrl"
									class="text-sm text-slate-700 flex-shrink-0 w-28 sm:w-32">Website URL</label
								>
								<select
									id="field-vis-websiteUrl"
									data-field="websiteUrl"
									class="field-visibility-select flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
								>
									<option value="public">Public — everyone</option>
									<option value="authenticated">CodePals only — signed-in</option>
									<option value="private">Only me</option>
								</select>
							</div>
						</div>
					</fieldset>

					<div class="flex gap-4 pt-4">
						<button
							type="button"
							id="form-cancel-btn"
							class="px-6 py-3 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors"
						>
							Cancel
						</button>
						<button
							type="submit"
							id="submit-btn"
							class="px-6 py-3 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors flex-1"
						>
							Save Profile
						</button>
					</div>
				</form>
			</div>
		</main>

		<Footer />

		<script>
			import {
				getPrincipal,
				getAvatarUrl,
				getProfile,
				saveProfile,
				HIDEABLE_FIELDS,
				type Profile,
				type FieldVisibility,
				type FieldVisibilityMap,
				type HideableField,
			} from '../../services/api';

			/**
			 * The non-public subset of FieldVisibility. The trimmed wire payload
			 * (see the save handler below) only ever carries 'authenticated' or
			 * 'private' entries — `public` is the default and gets dropped both
			 * client-side and by the server's normalizeFieldVisibility. Typing
			 * the local map this way means a future "store every value" change
			 * fails at the type level instead of silently shipping the wrong
			 * shape to the server.
			 */
			type StoredFieldVisibility = Exclude<FieldVisibility, 'public'>;

			let currentProfile: Profile | null = null;
			const skills = new Set<string>();
			const interests = new Set<string>();
			const languages = new Set<string>();

			function showViewMode() {
				document.getElementById('edit-mode')?.classList.add('hidden');
				document.getElementById('view-mode')?.classList.remove('hidden');
				document.getElementById('edit-btn')?.classList.remove('hidden');
				document.getElementById('cancel-btn')?.classList.add('hidden');
				history.replaceState(null, '', '/profile');
			}

			function showEditMode() {
				document.getElementById('view-mode')?.classList.add('hidden');
				document.getElementById('edit-mode')?.classList.remove('hidden');
				document.getElementById('edit-btn')?.classList.add('hidden');
				document.getElementById('cancel-btn')?.classList.remove('hidden');
				populateEditForm();
				history.replaceState(null, '', '/profile?edit=true');
			}

			// The public-directory quality bar. A profile meets this when all five
			// fields are filled: this is the single definition of "complete enough
			// to be listed publicly" — reused by (a) the incomplete-banner in view
			// mode and (b) the client-side save-gate for public visibility (issue
			// #68 + #69, kept together so the two never disagree on what counts).
			// Returns human-readable labels for the fields that are still missing.
			function computeMissingPublicFields(profile: Profile): string[] {
				const missing: string[] = [];
				if (!profile.bio || profile.bio.length < 50) missing.push('A bio (at least 50 characters)');
				if (!profile.skills || profile.skills.length < 2) missing.push('At least 2 skills');
				if (!profile.interests || profile.interests.length < 2)
					missing.push('At least 2 interests');
				if (!profile.location) missing.push('Your location');
				if (!profile.timezone) missing.push('Your timezone');
				return missing;
			}

			function populateViewMode(profile: Profile | null) {
				// Bio
				const bioEl = document.getElementById('profile-bio');
				const bioEmpty = document.getElementById('profile-bio-empty');
				if (profile?.bio) {
					bioEl.textContent = profile.bio;
					bioEl.classList.remove('hidden');
					bioEmpty.classList.add('hidden');
				} else {
					bioEl.classList.add('hidden');
					bioEmpty.classList.remove('hidden');
				}

				// Skills
				const skillsEl = document.getElementById('profile-skills');
				const skillsEmpty = document.getElementById('profile-skills-empty');
				skillsEl.innerHTML = '';
				if (profile?.skills?.length > 0) {
					profile.skills.forEach((skill) => {
						const span = document.createElement('span');
						span.className = 'px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm';
						span.textContent = skill;
						skillsEl.appendChild(span);
					});
					skillsEl.classList.remove('hidden');
					skillsEmpty.classList.add('hidden');
				} else {
					skillsEl.classList.add('hidden');
					skillsEmpty.classList.remove('hidden');
				}

				// Interests
				const interestsEl = document.getElementById('profile-interests');
				const interestsEmpty = document.getElementById('profile-interests-empty');
				interestsEl.innerHTML = '';
				if (profile?.interests?.length > 0) {
					profile.interests.forEach((interest) => {
						const span = document.createElement('span');
						span.className = 'px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm';
						span.textContent = interest;
						interestsEl.appendChild(span);
					});
					interestsEl.classList.remove('hidden');
					interestsEmpty.classList.add('hidden');
				} else {
					interestsEl.classList.add('hidden');
					interestsEmpty.classList.remove('hidden');
				}

				// Languages I speak. Same chip pattern as skills/interests;
				// slate palette so the three sections read as a coherent trio.
				const languagesEl = document.getElementById('profile-languages');
				const languagesEmpty = document.getElementById('profile-languages-empty');
				if (languagesEl && languagesEmpty) {
					languagesEl.innerHTML = '';
					if (profile?.preferredLanguages?.length > 0) {
						profile.preferredLanguages.forEach((lang) => {
							const span = document.createElement('span');
							span.className = 'px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-sm';
							span.textContent = lang;
							languagesEl.appendChild(span);
						});
						languagesEl.classList.remove('hidden');
						languagesEmpty.classList.add('hidden');
					} else {
						languagesEl.classList.add('hidden');
						languagesEmpty.classList.remove('hidden');
					}
				}

				// Details card. Build via DOM/textContent rather than innerHTML —
				// location/timezone/availability round-trip through Cosmos and are
				// user-controlled, so concatenating them into HTML is an XSS vector.
				const detailsCard = document.getElementById('profile-details-card');
				const locEl = document.getElementById('detail-location');
				const tzEl = document.getElementById('detail-timezone');
				const avEl = document.getElementById('detail-availability');

				function renderDetail(el, label, value) {
					el.replaceChildren();
					if (!value) {
						el.classList.add('hidden');
						return;
					}
					const labelSpan = document.createElement('span');
					labelSpan.className = 'font-semibold';
					labelSpan.textContent = label + ':';
					el.appendChild(labelSpan);
					el.appendChild(document.createTextNode(' ' + value));
					el.classList.remove('hidden');
				}

				renderDetail(locEl, 'Location', profile?.location);
				renderDetail(tzEl, 'Timezone', profile?.timezone);
				renderDetail(
					avEl,
					'Availability',
					profile?.availability ? profile.availability.replace('_', ' ') : ''
				);

				if (profile?.location || profile?.timezone || profile?.availability) {
					detailsCard.classList.remove('hidden');
				} else {
					detailsCard.classList.add('hidden');
				}

				// Visibility badge — public uses green, private uses slate. Defaults to
				// private for legacy docs missing the field.
				const visibilityBadge = document.getElementById('visibility-badge');
				if (visibilityBadge) {
					const visibility = profile?.profileVisibility ?? 'private';
					visibilityBadge.textContent =
						visibility === 'public' ? '🌍 Public profile' : '🔒 Private profile';
					visibilityBadge.className =
						'inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full ' +
						(visibility === 'public'
							? 'bg-green-100 text-green-700'
							: 'bg-slate-100 text-slate-600');
				}

				// Moderator-action banner (spec 003 US3 / issue #85). When
				// `unlistedBy` is set, the profile was unlisted by a
				// moderator — show a dedicated red banner distinct from the
				// owner-initiated private state. Also disables the public
				// visibility radio in edit mode so the owner can't just
				// toggle themselves back to public (bypassing the moderator
				// action); the server-side check that would also reject
				// this lives in S5 / the suspension chain.
				const unlistedBanner = document.getElementById('unlisted-banner');
				const unlistedByModerator = Boolean(profile?.unlistedBy);
				if (unlistedBanner) {
					unlistedBanner.classList.toggle('hidden', !unlistedByModerator);
				}
				const publicVisRadio = document.querySelector<HTMLInputElement>(
					'input[name="profileVisibility"][value="public"]'
				);
				if (publicVisRadio) publicVisRadio.disabled = unlistedByModerator;

				// Incomplete banner. Only shown for PUBLIC profiles that don't yet meet the
				// directory quality bar — private profiles are opted out of discovery, so
				// nagging them contradicts their choice. The copy lists ONLY the fields
				// actually missing (per issue #69 — the old static "add your bio, skills,
				// and interests" was wrong when the user had already added those).
				const banner = document.getElementById('incomplete-banner');
				const missingList = document.getElementById('incomplete-banner-missing');
				if (banner && missingList) {
					const visibility = profile?.profileVisibility ?? 'private';
					const missing = profile ? computeMissingPublicFields(profile) : [];
					const shouldShow = visibility === 'public' && missing.length > 0;
					banner.classList.toggle('hidden', !shouldShow);
					if (shouldShow) {
						missingList.innerHTML = '';
						for (const label of missing) {
							const li = document.createElement('li');
							li.textContent = label;
							missingList.appendChild(li);
						}
					}
				}
			}

			function populateEditForm() {
				const profile = currentProfile;
				const displayNameEl = document.getElementById('displayName') as HTMLInputElement | null;
				const bioEl = document.getElementById('bio') as HTMLTextAreaElement | null;
				const locationEl = document.getElementById('location') as HTMLInputElement | null;
				const timezoneEl = document.getElementById('timezone') as HTMLInputElement | null;
				const bioCountEl = document.getElementById('bio-count');

				if (displayNameEl) displayNameEl.value = profile?.displayName || '';
				if (bioEl) {
					bioEl.value = profile?.bio || '';
					if (bioCountEl) bioCountEl.textContent = String(bioEl.value.length);
				}
				if (locationEl) locationEl.value = profile?.location || '';
				if (timezoneEl) {
					// Prefill from stored profile OR detected browser zone on a fresh/empty
					// profile — any user with a modern browser has a sensible default rather
					// than an empty field. The user can still change it; this is a hint, not
					// a lock-in.
					if (profile?.timezone) {
						timezoneEl.value = profile.timezone;
					} else if (!timezoneEl.value) {
						try {
							const detected = Intl.DateTimeFormat().resolvedOptions().timeZone;
							if (detected) timezoneEl.value = detected;
						} catch {
							// Older browsers / sandboxes may lack this — not fatal.
						}
					}
				}

				if (profile?.availability) {
					const radio = document.querySelector<HTMLInputElement>(
						'input[name="availability"][value="' + profile.availability + '"]'
					);
					if (radio) radio.checked = true;
				}

				// Visibility — defaults to 'private' if missing (legacy docs).
				const visibility = profile?.profileVisibility ?? 'private';
				const visRadio = document.querySelector<HTMLInputElement>(
					'input[name="profileVisibility"][value="' + visibility + '"]'
				);
				if (visRadio) visRadio.checked = true;

				// Per-field visibility. Defaults to 'public' for every field
				// when the map is absent or the entry is missing — matches
				// backend's normalizeFieldVisibility (only non-public entries
				// are stored). Empty / legacy profiles render as all-public.
				//
				// The `field` from `dataset.field` is validated against
				// HIDEABLE_FIELDS before keying into the map. This keeps the
				// lookup type-safe AND defends against a regression where a
				// future `data-field` typo (e.g. `data-field="bio "`) silently
				// reads `undefined` and defaults to public — instead we now
				// skip the selector explicitly and a runtime smoke test would
				// catch the orphan.
				const fieldVis: FieldVisibilityMap = profile?.fieldVisibility ?? {};
				const hideableFields = new Set<string>(HIDEABLE_FIELDS);
				document.querySelectorAll<HTMLSelectElement>('.field-visibility-select').forEach((sel) => {
					const field = sel.dataset.field;
					if (!field || !hideableFields.has(field)) return;
					const level: FieldVisibility = fieldVis[field as HideableField] ?? 'public';
					sel.value = level;
				});

				skills.clear();
				(profile?.skills || []).forEach((s) => skills.add(s));
				renderTags('skills-container', skills);

				interests.clear();
				(profile?.interests || []).forEach((i) => interests.add(i));
				renderTags('interests-container', interests);

				languages.clear();
				(profile?.preferredLanguages || []).forEach((l) => languages.add(l));
				renderTags('languages-container', languages);

				// Optional scalar fields — empty / absent reads as empty input.
				const yearsEl = document.getElementById('years-of-experience') as HTMLInputElement | null;
				if (yearsEl) yearsEl.value = profile?.yearsOfExperience?.toString() ?? '';
				const githubUrlEl = document.getElementById('githubUrl') as HTMLInputElement | null;
				if (githubUrlEl) githubUrlEl.value = profile?.githubUrl ?? '';
				const linkedinUrlEl = document.getElementById('linkedinUrl') as HTMLInputElement | null;
				if (linkedinUrlEl) linkedinUrlEl.value = profile?.linkedinUrl ?? '';
				const websiteUrlEl = document.getElementById('websiteUrl') as HTMLInputElement | null;
				if (websiteUrlEl) websiteUrlEl.value = profile?.websiteUrl ?? '';
			}

			function renderTags(containerId: string, set: Set<string>) {
				const container = document.getElementById(containerId);
				if (!container) return;
				container.replaceChildren();
				set.forEach((text) => addTag(text, set, container));
			}

			function addTag(text: string, set: Set<string>, container: HTMLElement) {
				// Build via DOM — 'text' is user input, so keep it out of innerHTML.
				// The chip styling is uniform across every chip input on this page
				// (skills, interests, languages, …) — passing the Set directly
				// instead of a 'type' literal keeps the helper generic and lets new
				// chip inputs slot in without touching this function.
				const tag = document.createElement('span');
				tag.className =
					'inline-flex items-center gap-2 px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm';
				tag.dataset.value = text;
				tag.appendChild(document.createTextNode(text));
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'hover:text-primary-900 text-lg leading-none';
				btn.setAttribute('aria-label', 'Remove');
				btn.textContent = '×';
				btn.addEventListener('click', () => {
					set.delete(text);
					tag.remove();
				});
				tag.appendChild(document.createTextNode(' '));
				tag.appendChild(btn);
				container.appendChild(tag);
			}

			async function init() {
				// Populate the timezone combobox from the browser's IANA list
				// (~400 zones) — replaces the old 7-zone hardcoded <select>. See
				// issue #67. Falls back gracefully if Intl.supportedValuesOf
				// isn't available (very old browsers): the <input> still accepts
				// free text, just without suggestions.
				try {
					if (typeof Intl.supportedValuesOf === 'function') {
						const zones = Intl.supportedValuesOf('timeZone');
						const datalist = document.getElementById('timezone-options');
						if (datalist && zones.length > 0) {
							// Use a DocumentFragment so we don't reflow 400 times.
							// textContent-based option construction (never innerHTML) —
							// Intl's output is already a safe set of IANA strings, but
							// treating it as untrusted data is a cheap habit worth keeping.
							const fragment = document.createDocumentFragment();
							for (const zone of zones) {
								const opt = document.createElement('option');
								opt.value = zone;
								fragment.appendChild(opt);
							}
							datalist.appendChild(fragment);
						}
					}
				} catch {
					// Non-fatal: input remains a plain text field.
				}

				try {
					const [principal, profile] = await Promise.all([getPrincipal(), getProfile()]);

					if (!principal) {
						window.location.href = '/.auth/login/github?post_login_redirect_uri=/profile';
						return;
					}

					const username = principal.userDetails || 'User';
					const avatarUrl = getAvatarUrl(principal);
					const avatarEl = document.getElementById('profile-avatar') as HTMLImageElement | null;
					if (avatarEl) {
						avatarEl.src = avatarUrl;
						avatarEl.alt = username;
					}
					const usernameEl = document.getElementById('username-display');
					if (usernameEl) usernameEl.textContent = '@' + username;

					currentProfile = profile;
					populateViewMode(currentProfile);

					const isEditMode = new URLSearchParams(window.location.search).get('edit') === 'true';
					if (isEditMode) {
						showEditMode();
					} else {
						showViewMode();
					}

					document.getElementById('loading-state')?.classList.add('hidden');
					document.getElementById('profile-main')?.classList.remove('hidden');
				} catch (error) {
					console.error('Profile init failed:', error);
					document.getElementById('loading-state')?.classList.add('hidden');
					document.getElementById('error-state')?.classList.remove('hidden');
				}
			}

			// Mode toggle buttons (replace the old inline onclick handlers).
			document.getElementById('edit-btn')?.addEventListener('click', showEditMode);
			document.getElementById('cancel-btn')?.addEventListener('click', showViewMode);
			document.getElementById('complete-profile-btn')?.addEventListener('click', showEditMode);
			document.getElementById('form-cancel-btn')?.addEventListener('click', showViewMode);
			document
				.getElementById('error-refresh-btn')
				?.addEventListener('click', () => window.location.reload());

			// Bio character counter
			document.getElementById('bio')?.addEventListener('input', (e) => {
				const target = e.target as HTMLTextAreaElement;
				const counter = document.getElementById('bio-count');
				if (counter) counter.textContent = String(target.value.length);
			});

			function bindTagInput(inputId: string, containerId: string, set: Set<string>) {
				const input = document.getElementById(inputId) as HTMLInputElement | null;
				const container = document.getElementById(containerId);
				if (!input || !container) return;
				input.addEventListener('keydown', (e) => {
					if (e.key !== 'Enter' && e.key !== ',') return;
					e.preventDefault();
					const value = input.value.replace(/,/g, '').trim();
					if (value && !set.has(value)) {
						set.add(value);
						addTag(value, set, container);
					}
					input.value = '';
				});
			}
			bindTagInput('skills-input', 'skills-container', skills);
			bindTagInput('interests-input', 'interests-container', interests);
			bindTagInput('languages-input', 'languages-container', languages);

			// Form submission
			document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
				e.preventDefault();

				const displayNameEl = document.getElementById('displayName') as HTMLInputElement | null;
				const bioEl = document.getElementById('bio') as HTMLTextAreaElement | null;
				const locationEl = document.getElementById('location') as HTMLInputElement | null;
				const timezoneEl = document.getElementById('timezone') as HTMLInputElement | null;
				const yearsEl = document.getElementById('years-of-experience') as HTMLInputElement | null;
				const githubUrlEl = document.getElementById('githubUrl') as HTMLInputElement | null;
				const linkedinUrlEl = document.getElementById('linkedinUrl') as HTMLInputElement | null;
				const websiteUrlEl = document.getElementById('websiteUrl') as HTMLInputElement | null;
				const availabilityEl = document.querySelector<HTMLInputElement>(
					'input[name="availability"]:checked'
				);
				const visibilityEl = document.querySelector<HTMLInputElement>(
					'input[name="profileVisibility"]:checked'
				);
				const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

				const bio = bioEl?.value || '';
				const selectedVisibility =
					(visibilityEl?.value as Profile['profileVisibility']) || 'private';

				// Strict directory-quality gate — ONLY when publishing publicly (#68).
				// A private profile is a work-in-progress by design; forcing every
				// field before "save" makes the form hostile and prevents drafting.
				// The abuse limits (bio ≤ 500, skills ≤ 30 tags, etc.) still apply
				// server-side regardless of visibility.
				if (selectedVisibility === 'public') {
					if (bio.length < 50) {
						alert('Public profiles need a bio of at least 50 characters.');
						return;
					}
					if (skills.size < 2) {
						alert('Public profiles need at least 2 skills.');
						return;
					}
					if (interests.size < 2) {
						alert('Public profiles need at least 2 interests.');
						return;
					}
				}

				if (submitBtn) {
					submitBtn.disabled = true;
					submitBtn.textContent = 'Saving…';
				}

				// Gather per-field visibility selectors into the wire shape.
				// Drop 'public' entries client-side too — the server already
				// does this in normalizeFieldVisibility, but trimming here
				// keeps the request body small for users who never opened
				// the visibility section. The server remains the security
				// boundary; this is purely a wire-size optimisation.
				//
				// Typed as Partial<Record<HideableField, StoredFieldVisibility>>
				// so the local shape honestly reflects what flows to the wire:
				// keys are restricted to the HIDEABLE_FIELDS whitelist, values
				// to the non-public subset. A future change that tries to
				// stuff a `'public'` entry in fails at the type level.
				const fieldVisibility: Partial<Record<HideableField, StoredFieldVisibility>> = {};
				const hideableSet = new Set<string>(HIDEABLE_FIELDS);
				document.querySelectorAll<HTMLSelectElement>('.field-visibility-select').forEach((sel) => {
					const field = sel.dataset.field;
					const value = sel.value;
					if (!field || !hideableSet.has(field)) return;
					if (value === 'authenticated' || value === 'private') {
						fieldVisibility[field as HideableField] = value;
					}
				});

				// Years of experience: <input type="number"> ships a string;
				// coerce to a bounded integer matching the server-side
				// boundedInteger semantics in api/src/lib/validation.ts.
				// Symmetry matters: if the client sends a value the server
				// will silently drop (e.g. "5e2" parses as 500 via Number;
				// >60 fails the server bound; "5x" → NaN), the user sees
				// "save succeeded" but the value isn't stored. Using the
				// same parsing + bounds here means the wire payload only
				// ever carries what the server will accept.
				//
				// Number() (not parseInt) rejects "5x"/"abc" as NaN —
				// parseInt would have leniently returned 5. Math.floor
				// matches the server's behaviour on fractional values
				// (5.7 → 5). [0, 60] is the same bound.
				const yearsRaw = yearsEl?.value?.trim() ?? '';
				const yearsNum = yearsRaw === '' ? NaN : Number(yearsRaw);
				const yearsFloored = Number.isFinite(yearsNum) ? Math.floor(yearsNum) : NaN;
				const yearsOfExperience =
					Number.isFinite(yearsFloored) && yearsFloored >= 0 && yearsFloored <= 60
						? yearsFloored
						: undefined;

				// URLs: pass through the browser-trimmed value. The server's
				// sanitizedUrl() enforces https:// — invalid inputs are dropped
				// silently there, not here. We pass empty strings as undefined
				// so the request body doesn't carry noise.
				const trimmedUrl = (v: string | undefined): string | undefined => {
					const t = v?.trim();
					return t ? t : undefined;
				};

				// Spoken languages — same chip-set pattern as skills/interests,
				// converted to an Array for the wire. Empty list elides the
				// field entirely (smaller request body for users who don't fill it).
				const languagesArray = Array.from(languages);

				try {
					const saved = await saveProfile({
						displayName: displayNameEl?.value || '',
						bio,
						skills: Array.from(skills),
						interests: Array.from(interests),
						location: locationEl?.value,
						timezone: timezoneEl?.value,
						availability: (availabilityEl?.value as Profile['availability']) || 'active',
						profileVisibility: selectedVisibility,
						fieldVisibility,
						yearsOfExperience,
						githubUrl: trimmedUrl(githubUrlEl?.value),
						linkedinUrl: trimmedUrl(linkedinUrlEl?.value),
						websiteUrl: trimmedUrl(websiteUrlEl?.value),
						preferredLanguages: languagesArray.length > 0 ? languagesArray : undefined,
					});
					currentProfile = saved;
					populateViewMode(currentProfile);
					showViewMode();
				} catch (err) {
					alert(err instanceof Error ? err.message : 'Failed to save profile');
				} finally {
					if (submitBtn) {
						submitBtn.disabled = false;
						submitBtn.textContent = 'Save Profile';
					}
				}
			});

			init();
		</script>

		<style is:global>
			/*
			 * Hide the WebKit native dropdown arrow on datalist-bound inputs
			 * (Chrome / Edge). Browsers show it to hint "clickable dropdown",
			 * but with an already-complete value in the field (e.g.
			 * Europe/Paris) nothing opens on click because every suggestion
			 * is filtered out — reads as "broken dropdown" to users.
			 *
			 * The field still accepts free text and surfaces matching
			 * suggestions as the user types; the arrow is removed, not the
			 * suggestions themselves.
			 */
			input.tz-input::-webkit-calendar-picker-indicator {
				display: none !important;
			}
		</style>
	</body>
</html>
