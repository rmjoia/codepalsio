---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import PrivacyModal from '../components/PrivacyModal.astro';
import TermsModal from '../components/TermsModal.astro';
import CodeOfConductModal from '../components/CodeOfConductModal.astro';
import SponsorshipModal from '../components/SponsorshipModal.astro';
import SEO from '../components/SEO.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#00bcd4" />

		<!-- Preconnect to external resources. GitHub is listed because
			the Header + /find avatars resolve to github.com/<login>.png and
			preconnecting shaves ~100ms off the first-contentful-paint of
			any page that renders a signed-in avatar. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://github.com" crossorigin />

		<!-- Google Fonts -->
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Clash+Display:wght@600;700&display=swap"
			rel="stylesheet"
		/>

		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />

		<SEO
			title="CodePals — Code penpals, developer mentorship, pair programming"
			description="CodePals is a developer community for code-related mentorship, pair programming, and learning. Find a code penpal who matches your stack and goals."
			canonical="/"
		/>

		<!-- JSON-LD structured data: Organization + WebSite. Helps search
			engines render the brand knowledge panel and (eventually)
			a site search box in the SERP. -->
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@graph': [
					{
						'@type': 'Organization',
						'@id': 'https://codepals.io/#organization',
						name: 'CodePals',
						url: 'https://codepals.io/',
						logo: 'https://codepals.io/codepals00.jpg',
						description:
							'A developer community for code-related mentorship, pair programming, and learning.',
						sameAs: ['https://github.com/rmjoia/codepalsio'],
					},
					{
						'@type': 'WebSite',
						'@id': 'https://codepals.io/#website',
						url: 'https://codepals.io/',
						name: 'CodePals',
						description:
							'Code penpals for developers — mentorship, pair programming, and learning.',
						publisher: { '@id': 'https://codepals.io/#organization' },
						inLanguage: 'en',
					},
				],
			})}
		/>
	</head>
	<body class="bg-white">
		<Header />
		<Hero />
		<Features />
		<HowItWorks />
		<CTA />
		<Footer />

		<!-- Legal Modals -->
		<PrivacyModal />
		<TermsModal />
		<CodeOfConductModal />
		<SponsorshipModal />

		<!-- Smooth-scroll, hash-on-load, and navbar shadow effects are
		     initialised globally by Header.astro via setupSmoothScroll()
		     (src/lib/smooth-scroll.ts). Kept out of an inline script
		     here so CSP `script-src 'self'` allows them. -->
	</body>
</html>
