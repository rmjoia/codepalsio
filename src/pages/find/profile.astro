---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEO from '../../components/SEO.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#00bcd4" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<SEO
			title="CodePal profile"
			description="View a CodePals developer profile — bio, skills, interests, and ways to connect."
			canonical="/find"
			noindex={true}
		/>
	</head>
	<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen flex flex-col">
		<Header />

		<!-- Loading -->
		<div id="loading-state" class="flex-1 flex justify-center items-center min-h-[60vh]">
			<div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-500"></div>
		</div>

		<!-- Not found (404) — profile doesn't exist -->
		<main
			id="not-found-state"
			class="hidden flex-1 mx-auto max-w-2xl w-full px-4 py-16 text-center"
		>
			<div class="text-6xl font-bold text-slate-300 mb-2">404</div>
			<h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">No CodePal here</h1>
			<p class="text-slate-600 mb-2">
				No profile exists for <code
					id="not-found-username"
					class="font-mono bg-slate-100 px-1.5 py-0.5 rounded text-sm"></code>.
			</p>
			<p class="text-slate-500 text-sm mb-8">
				Either the username is off, or this person hasn't joined CodePals yet.
			</p>
			<div class="flex flex-wrap gap-3 justify-center">
				<a
					href="/find"
					class="px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
				>
					Browse CodePals
				</a>
				<a
					href="/"
					class="px-4 py-2 bg-white text-slate-700 border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
				>
					Back home
				</a>
			</div>
		</main>

		<!-- Private (403) — profile exists but isn't public -->
		<main id="private-state" class="hidden flex-1 mx-auto max-w-2xl w-full px-4 py-16 text-center">
			<div class="text-6xl font-bold text-slate-300 mb-2">403</div>
			<h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">This profile is private</h1>
			<p class="text-slate-600 mb-2">
				<code id="private-username" class="font-mono bg-slate-100 px-1.5 py-0.5 rounded text-sm"
				></code>
				is a CodePal, but they've kept their profile private.
			</p>
			<p class="text-slate-500 text-sm mb-8">
				Only the profile owner can change visibility settings.
			</p>
			<div class="flex flex-wrap gap-3 justify-center">
				<a
					href="/find"
					class="px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
				>
					Browse public CodePals
				</a>
				<a
					href="/"
					class="px-4 py-2 bg-white text-slate-700 border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
				>
					Back home
				</a>
			</div>
		</main>

		<!-- Generic error (500, network) -->
		<main id="error-state" class="hidden flex-1 mx-auto max-w-2xl w-full px-4 py-16 text-center">
			<h1 class="text-2xl font-bold text-red-700 mb-2">Couldn't load this profile</h1>
			<p class="text-slate-600 mb-6">
				Something went wrong on our side. Please try again in a moment.
			</p>
			<button
				id="profile-refresh-btn"
				class="px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
			>
				Refresh
			</button>
		</main>

		<!-- Profile detail -->
		<main
			id="profile-state"
			class="hidden flex-1 mx-auto max-w-3xl w-full px-4 sm:px-6 lg:px-8 py-12"
		>
			<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">
				<!-- Header: avatar + name + availability -->
				<div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-6">
					<div id="profile-avatar-slot" class="flex-shrink-0"></div>
					<div class="min-w-0 flex-1">
						<h1
							id="profile-display-name"
							class="text-2xl sm:text-3xl font-bold text-slate-900 truncate"
						>
						</h1>
						<p id="profile-handle" class="text-slate-500 truncate"></p>
					</div>
					<span
						id="profile-availability"
						class="text-sm font-medium px-3 py-1 rounded-full whitespace-nowrap"></span>
				</div>

				<!-- Bio -->
				<p id="profile-bio" class="text-slate-700 whitespace-pre-wrap mb-6"></p>

				<!-- Meta: location, timezone, experience -->
				<dl
					id="profile-meta"
					class="hidden grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6 p-4 bg-slate-50 rounded-lg text-sm"
				>
				</dl>

				<!-- Skills -->
				<section id="profile-skills-section" class="hidden mb-6">
					<h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2">Skills</h2>
					<div id="profile-skills" class="flex flex-wrap gap-2"></div>
				</section>

				<!-- Interests -->
				<section id="profile-interests-section" class="hidden mb-6">
					<h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2">
						Interested in
					</h2>
					<div id="profile-interests" class="flex flex-wrap gap-2"></div>
				</section>

				<!-- Spoken languages -->
				<section id="profile-languages-section" class="hidden mb-6">
					<h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2">Speaks</h2>
					<div id="profile-languages" class="flex flex-wrap gap-2"></div>
				</section>

				<!-- Contact — the primary CTA on this page while in-app messaging
					is still unimplemented (spec 005 queued). Surfaces whichever of
					githubUrl / linkedinUrl / websiteUrl the profile has set, as
					prominent buttons. Falls back to github.com/<githubUsername>
					when no explicit github URL is set — every CodePal has a
					GitHub login by definition. Set-expectations copy makes clear
					that in-app messaging is coming; this is the bridge.
					See issue #73. -->
				<section id="profile-contact-section" class="hidden mb-6">
					<h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2">
						Get in touch
					</h2>
					<p id="profile-contact-note" class="text-sm text-slate-600 mb-3">
						In-app messaging is coming soon. For now, find them via one of the links below, or say
						hi in our{' '}
						<a
							href="https://discord.gg/6RCRNCUq8Q"
							target="_blank"
							rel="noopener noreferrer"
							class="text-primary-600 hover:text-primary-700 font-semibold underline"
							>Discord community</a
						>{' '}
						where everyone can be reached.
					</p>
					<div id="profile-contact-buttons" class="flex flex-wrap gap-2"></div>
				</section>

				<!-- Report affordance (spec 003 US2). A small, secondary-styled
					button below Contact so it reads as "if something's off, do
					this" rather than competing with the primary CTA. Hidden on
					self-view (self-report rejected per spec 003 edge cases, and
					defensive against the server-side guard — see
					report-submit.ts). Hidden under 403/404 states because the
					whole #profile-state is hidden in those branches. -->
				<div id="profile-report-wrap" class="hidden mb-6">
					<button
						id="profile-report-btn"
						type="button"
						class="text-sm text-slate-500 hover:text-red-600 underline underline-offset-2 transition-colors"
					>
						Report this profile
					</button>
				</div>

				<!-- Footer: last updated -->
				<p
					id="profile-updated"
					class="hidden text-xs text-slate-400 pt-4 border-t border-slate-100"
				>
				</p>
			</div>
		</main>

		<Footer />

		<!-- Report dialog (spec 003 US2). <dialog> element is browser-native —
			no custom modal library needed, keyboard + escape handling comes for
			free, and the backdrop ::backdrop pseudo-element gets a tasteful dim
			without extra DOM. Starts hidden; the Report button calls
			showModal() which also makes it inert-blocking for the rest of the
			page (focus trapped, Tab stays inside). -->
		<dialog
			id="report-dialog"
			class="rounded-xl p-0 w-full max-w-md backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm"
		>
			<form id="report-form" method="dialog" class="p-6">
				<h2 class="text-lg font-bold text-slate-900 mb-2">Report this profile</h2>
				<p class="text-sm text-slate-600 mb-4">
					Reports are reviewed by platform moderators. We won't share your identity with the
					reported user. See
					<a
						href="/terms"
						target="_blank"
						rel="noopener noreferrer"
						class="text-primary-600 hover:text-primary-700 underline">Terms § 9</a
					>.
				</p>

				<fieldset class="mb-4">
					<legend class="text-sm font-semibold text-slate-900 mb-2">Reason</legend>
					<div class="space-y-2 text-sm text-slate-700">
						<label class="flex items-start gap-2 cursor-pointer">
							<input type="radio" name="report-reason" value="off_topic" class="mt-0.5" required />
							<span>
								<strong>Off-topic outreach</strong> — dating, romantic, or purely social contact (unrelated
								to coding collaboration)
							</span>
						</label>
						<label class="flex items-start gap-2 cursor-pointer">
							<input type="radio" name="report-reason" value="harassment" class="mt-0.5" />
							<span
								><strong>Harassment</strong> — targeted unwanted contact, slurs, repeated unwelcome outreach</span
							>
						</label>
						<label class="flex items-start gap-2 cursor-pointer">
							<input type="radio" name="report-reason" value="impersonation" class="mt-0.5" />
							<span
								><strong>Impersonation</strong> — this profile claims to be someone they're not</span
							>
						</label>
						<label class="flex items-start gap-2 cursor-pointer">
							<input type="radio" name="report-reason" value="spam" class="mt-0.5" />
							<span>
								<strong>Spam</strong> — unsolicited commercial outreach (recruiting, sales, marketing)
								or deceptive content
							</span>
						</label>
						<label class="flex items-start gap-2 cursor-pointer">
							<input type="radio" name="report-reason" value="other" class="mt-0.5" />
							<span><strong>Other</strong> — add context in the note below</span>
						</label>
					</div>
				</fieldset>

				<label for="report-note" class="block text-sm font-semibold text-slate-900 mb-1">
					Note <span class="font-normal text-slate-500">(optional)</span>
				</label>
				<textarea
					id="report-note"
					name="report-note"
					rows="3"
					maxlength="500"
					class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 mb-1"
					placeholder="What happened? Links, dates, context — up to 500 characters."></textarea>
				<p class="text-xs text-slate-500 mb-4">
					<span id="report-note-count">0</span> / 500
				</p>

				<p
					id="report-error"
					class="hidden text-sm text-red-600 mb-3"
					role="alert"
					aria-live="polite"
				>
				</p>

				<div class="flex items-center justify-end gap-2">
					<button
						id="report-cancel-btn"
						type="button"
						class="px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100 rounded-lg transition-colors"
					>
						Cancel
					</button>
					<button
						id="report-submit-btn"
						type="submit"
						class="px-4 py-2 text-sm font-semibold text-white bg-primary-500 hover:bg-primary-600 disabled:bg-slate-400 disabled:cursor-not-allowed rounded-lg transition-colors"
					>
						Submit report
					</button>
				</div>
			</form>
		</dialog>

		<!-- Toast confirmation (shown after a successful report submission).
			Isolated from the dialog so it survives dialog close. Starts hidden;
			shown briefly after the POST resolves. -->
		<div
			id="report-toast"
			role="status"
			aria-live="polite"
			class="hidden fixed bottom-6 right-6 bg-slate-900 text-white px-4 py-3 rounded-lg shadow-xl text-sm"
		>
			Thanks, we'll review.
		</div>

		<script>
			import {
				getPublicProfileByUsername,
				getProfileAvatarUrl,
				getPrincipal,
				submitReport,
				type PublicProfile,
				type ReportReason,
			} from '../../services/api';

			/**
			 * Extract the username segment from /find/<username>. Trailing
			 * slashes are tolerated (filter(Boolean) drops the empty piece).
			 * Invalid shapes return null so the page falls through to the
			 * not-found branch — single error path, same UX as a missing
			 * profile. Rejects:
			 *   - empty path (parts[0] !== 'find')
			 *   - /find with no segment (parts.length !== 2)
			 *   - /find/<u>/<more> (parts.length !== 2)
			 *   - malformed percent-encoding e.g. /find/%E0%A4 — decodeURIComponent
			 *     throws URIError on invalid sequences; treat as not-found
			 */
			function getUsernameFromPath(): string | null {
				const parts = window.location.pathname.split('/').filter(Boolean);
				if (parts[0] !== 'find' || parts.length !== 2) return null;
				try {
					const username = decodeURIComponent(parts[1]);
					return username || null;
				} catch {
					return null;
				}
			}

			function availabilityBadge(availability: PublicProfile['availability']): {
				label: string;
				cls: string;
			} {
				switch (availability) {
					case 'active':
						return { label: '🟢 Active', cls: 'bg-green-100 text-green-700' };
					case 'casual':
						return { label: '🟡 Casual', cls: 'bg-amber-100 text-amber-700' };
					case 'unavailable':
						return { label: '⚪ Not available', cls: 'bg-slate-100 text-slate-600' };
					default:
						return { label: '⚪ Unknown', cls: 'bg-slate-100 text-slate-600' };
				}
			}

			function renderChips(container: HTMLElement, items: string[], cls: string): void {
				items.forEach((item) => {
					const chip = document.createElement('span');
					chip.className = `px-2.5 py-1 text-xs rounded-full ${cls}`;
					chip.textContent = item;
					container.appendChild(chip);
				});
			}

			function renderMeta(profile: PublicProfile): void {
				const dl = document.getElementById('profile-meta');
				if (!dl) return;

				const rows: Array<[string, string]> = [];
				if (profile.location) rows.push(['Location', profile.location]);
				if (profile.timezone) rows.push(['Timezone', profile.timezone]);
				if (typeof profile.yearsOfExperience === 'number') {
					const yrs = profile.yearsOfExperience;
					rows.push(['Experience', yrs === 1 ? '1 year' : `${yrs} years`]);
				}

				if (rows.length === 0) return;

				rows.forEach(([label, value]) => {
					const wrap = document.createElement('div');
					const dt = document.createElement('dt');
					dt.className = 'text-xs font-semibold text-slate-500 uppercase tracking-wide';
					dt.textContent = label;
					const dd = document.createElement('dd');
					dd.className = 'text-slate-800';
					dd.textContent = value;
					wrap.appendChild(dt);
					wrap.appendChild(dd);
					dl.appendChild(wrap);
				});
				dl.classList.remove('hidden');
			}

			function renderContact(profile: PublicProfile): void {
				const container = document.getElementById('profile-contact-buttons');
				const section = document.getElementById('profile-contact-section');
				if (!container || !section) return;

				// Collect the available contact routes in priority order:
				// explicit githubUrl, otherwise the fallback to the canonical
				// github.com/<username>; LinkedIn and Website only when
				// explicitly set. The fallback matters — a profile with no
				// explicit URLs still has a reachable owner via GitHub.
				const routes: Array<{ label: string; href: string; variant: 'primary' | 'secondary' }> = [];
				if (profile.githubUrl) {
					routes.push({ label: 'GitHub', href: profile.githubUrl, variant: 'primary' });
				} else if (profile.githubUsername) {
					routes.push({
						label: 'GitHub',
						href: `https://github.com/${profile.githubUsername}`,
						variant: 'primary',
					});
				}
				if (profile.linkedinUrl) {
					routes.push({ label: 'LinkedIn', href: profile.linkedinUrl, variant: 'secondary' });
				}
				if (profile.websiteUrl) {
					routes.push({ label: 'Website', href: profile.websiteUrl, variant: 'secondary' });
				}

				// Always reveal the section even if the profile exposes zero
				// explicit contact URLs — the inline Discord link in the
				// note copy is itself a reachable path, and hiding the
				// whole section would hide that too. The buttons container
				// may simply end up empty.

				// Button-style anchors (not inline text) so the Contact affordance
				// reads as the primary CTA on this page. target=_blank +
				// rel=noopener,noreferrer are mandatory for cross-origin links
				// (prevents the opened page from controlling our window.opener
				// and avoids leaking the referrer header).
				routes.forEach(({ label, href, variant }) => {
					const a = document.createElement('a');
					a.href = href;
					a.target = '_blank';
					a.rel = 'noopener noreferrer';
					a.className =
						variant === 'primary'
							? 'inline-flex items-center gap-2 px-4 py-2 bg-primary-500 text-white rounded-lg font-semibold hover:bg-primary-600 transition-colors text-sm'
							: 'inline-flex items-center gap-2 px-4 py-2 bg-white text-primary-600 border border-primary-500 rounded-lg font-semibold hover:bg-primary-50 transition-colors text-sm';
					a.textContent = label;
					container.appendChild(a);
				});
				section.classList.remove('hidden');
			}

			/**
			 * Report-affordance wiring (spec 003 US2).
			 *
			 * Called from the resolved-profile branch of renderProfile. The
			 * button + dialog markup lives in the body (near Footer); this
			 * function (a) hides the button on self-view, (b) opens the
			 * dialog on click, (c) wires submission to POST /api/report.
			 *
			 * Self-view check: compare the viewer's SWA userDetails (GitHub
			 * login) to the profile's githubUsername, case-insensitive —
			 * same semantics as the "you're listed" banner in /find. The
			 * server also rejects self-reports (defence in depth); this
			 * client-side hide is UX hygiene so the button simply never
			 * appears when it wouldn't work.
			 */
			async function wireReportAffordance(profile: PublicProfile): Promise<void> {
				const wrap = document.getElementById('profile-report-wrap');
				const btn = document.getElementById('profile-report-btn') as HTMLButtonElement | null;
				const dialog = document.getElementById('report-dialog') as HTMLDialogElement | null;
				if (!wrap || !btn || !dialog) return;

				// Only show the Report button to signed-in users who are
				// NOT the profile owner. Anonymous viewers already can't
				// reach the detail page (SWA route gate); if principal
				// resolution fails for any reason, fail-closed and don't
				// surface the button.
				const principal = await getPrincipal().catch(() => null);
				if (!principal) return;
				const viewerLogin = (principal.userDetails ?? '').toLowerCase();
				const ownerLogin = (profile.githubUsername ?? '').toLowerCase();
				if (viewerLogin && ownerLogin && viewerLogin === ownerLogin) {
					// Self-view — keep hidden.
					return;
				}

				wrap.classList.remove('hidden');

				const form = document.getElementById('report-form') as HTMLFormElement | null;
				const cancelBtn = document.getElementById('report-cancel-btn') as HTMLButtonElement | null;
				const submitBtn = document.getElementById('report-submit-btn') as HTMLButtonElement | null;
				const noteEl = document.getElementById('report-note') as HTMLTextAreaElement | null;
				const noteCount = document.getElementById('report-note-count');
				const errorEl = document.getElementById('report-error');
				const toast = document.getElementById('report-toast');

				btn.addEventListener('click', () => {
					// Reset form state each time the dialog opens — a prior
					// error or a prior reason selection shouldn't bleed into
					// a fresh report.
					form?.reset();
					if (noteCount) noteCount.textContent = '0';
					if (errorEl) {
						errorEl.textContent = '';
						errorEl.classList.add('hidden');
					}
					dialog.showModal();
				});

				cancelBtn?.addEventListener('click', () => dialog.close());

				noteEl?.addEventListener('input', () => {
					if (noteCount) noteCount.textContent = String(noteEl.value.length);
				});

				form?.addEventListener('submit', async (e) => {
					// The <form method="dialog"> default closes the dialog
					// WITHOUT firing a POST — prevent that and drive the
					// fetch ourselves so errors stay visible in the error
					// element instead of closing on failure.
					e.preventDefault();
					if (!submitBtn) return;

					const reasonInput = form.querySelector<HTMLInputElement>(
						'input[name="report-reason"]:checked'
					);
					if (!reasonInput) {
						if (errorEl) {
							errorEl.textContent = 'Please pick a reason.';
							errorEl.classList.remove('hidden');
						}
						return;
					}
					const reason = reasonInput.value as ReportReason;
					const note = noteEl?.value?.trim() || undefined;

					submitBtn.disabled = true;
					submitBtn.textContent = 'Submitting…';
					if (errorEl) errorEl.classList.add('hidden');

					try {
						await submitReport({
							reportedProfileId: profile.id,
							reason,
							note,
						});
						dialog.close();
						// Short-lived confirmation toast — the response is
						// deliberately opaque (FR-113), so this is the only
						// feedback the reporter gets.
						if (toast) {
							toast.classList.remove('hidden');
							setTimeout(() => toast.classList.add('hidden'), 4000);
						}
					} catch (err) {
						if (errorEl) {
							errorEl.textContent =
								err instanceof Error && err.message
									? `Couldn't submit: ${err.message}`
									: "Couldn't submit the report. Please try again.";
							errorEl.classList.remove('hidden');
						}
					} finally {
						submitBtn.disabled = false;
						submitBtn.textContent = 'Submit report';
					}
				});
			}

			function renderProfile(profile: PublicProfile): void {
				const nameEl = document.getElementById('profile-display-name');
				const handleEl = document.getElementById('profile-handle');
				const avatarSlot = document.getElementById('profile-avatar-slot');
				const availabilityEl = document.getElementById('profile-availability');
				const bioEl = document.getElementById('profile-bio');

				if (nameEl) nameEl.textContent = profile.displayName;
				if (handleEl && profile.githubUsername) handleEl.textContent = '@' + profile.githubUsername;
				// Bio is optional under per-field visibility; hide the
				// element entirely when the field was stripped so the page
				// doesn't show a blank-but-styled paragraph.
				if (bioEl) {
					if (profile.bio) {
						bioEl.textContent = profile.bio;
					} else {
						bioEl.classList.add('hidden');
					}
				}

				if (avatarSlot) {
					const avatarUrl = getProfileAvatarUrl(profile);
					if (avatarUrl) {
						const img = document.createElement('img');
						img.src = avatarUrl;
						img.alt = profile.displayName;
						img.className = 'w-20 h-20 rounded-full border-2 border-primary-100';
						avatarSlot.appendChild(img);
					} else {
						const placeholder = document.createElement('div');
						placeholder.className =
							'w-20 h-20 rounded-full bg-primary-500 text-white flex items-center justify-center text-2xl font-semibold';
						placeholder.textContent = (profile.displayName || '?').charAt(0).toUpperCase();
						avatarSlot.appendChild(placeholder);
					}
				}

				if (availabilityEl) {
					const badge = availabilityBadge(profile.availability);
					availabilityEl.textContent = badge.label;
					availabilityEl.classList.add(...badge.cls.split(' '));
				}

				// Skills and interests are optional under per-field visibility
				// — guard against the absent case (their <section> stays
				// `hidden` if the field was stripped or empty).
				const skillsList = profile.skills ?? [];
				if (skillsList.length > 0) {
					const skills = document.getElementById('profile-skills');
					const section = document.getElementById('profile-skills-section');
					if (skills && section) {
						renderChips(skills, skillsList, 'bg-primary-50 text-primary-700');
						section.classList.remove('hidden');
					}
				}

				const interestsList = profile.interests ?? [];
				if (interestsList.length > 0) {
					const interests = document.getElementById('profile-interests');
					const section = document.getElementById('profile-interests-section');
					if (interests && section) {
						renderChips(interests, interestsList, 'bg-accent-50 text-accent-700');
						section.classList.remove('hidden');
					}
				}

				if (profile.preferredLanguages && profile.preferredLanguages.length > 0) {
					const langs = document.getElementById('profile-languages');
					const section = document.getElementById('profile-languages-section');
					if (langs && section) {
						renderChips(langs, profile.preferredLanguages, 'bg-slate-100 text-slate-700');
						section.classList.remove('hidden');
					}
				}

				renderMeta(profile);
				renderContact(profile);
				// Fire-and-forget — the report-affordance wiring doesn't block
				// the rest of the render (it only reveals a button once the
				// principal resolves, independent of profile paint). Awaiting
				// here would force renderProfile() async and ripple through
				// its callers for no visible-UX gain.
				void wireReportAffordance(profile);

				if (profile.updatedAt) {
					const el = document.getElementById('profile-updated');
					if (el) {
						const d = new Date(profile.updatedAt);
						el.textContent = Number.isNaN(d.getTime())
							? ''
							: 'Last updated ' + d.toLocaleDateString();
						el.classList.remove('hidden');
					}
				}

				const title = profile.githubUsername
					? `${profile.displayName} (@${profile.githubUsername}) — CodePals`
					: `${profile.displayName} — CodePals`;
				document.title = title;
			}

			function show(id: string, usernameForLabel?: string): void {
				const loading = document.getElementById('loading-state');
				loading?.classList.add('hidden');
				const target = document.getElementById(id);
				target?.classList.remove('hidden');
				if (usernameForLabel) {
					const label = id === 'not-found-state' ? 'not-found-username' : 'private-username';
					const el = document.getElementById(label);
					if (el) el.textContent = '@' + usernameForLabel;
				}
			}

			async function init(): Promise<void> {
				const username = getUsernameFromPath();
				if (!username) {
					show('not-found-state', '');
					return;
				}

				try {
					const result = await getPublicProfileByUsername(username);
					if (result.kind === 'not-found') {
						show('not-found-state', username);
						return;
					}
					if (result.kind === 'private') {
						show('private-state', username);
						return;
					}
					show('profile-state');
					renderProfile(result.profile);
				} catch (err) {
					console.error('Profile load failed:', err);
					show('error-state');
				}
			}

			document
				.getElementById('profile-refresh-btn')
				?.addEventListener('click', () => window.location.reload());
			init();
		</script>
	</body>
</html>
