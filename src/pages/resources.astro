			{
				title: 'Bytes',
				description:
					'The front-end-focused companion to the above. Funny, well-curated, lands in your inbox weekly.',
				href: 'https://bytes.dev/',
				source: 'bytes.dev',
			},
			{
				title: 'Node Weekly',
				description:
					'Same house as JavaScript Weekly, server-side focused. New runtimes, security advisories, release notes.',
				href: 'https://nodeweekly.com/',
				source: 'nodeweekly.com',
			},
			{
				title: 'CSS Weekly',
				description:
					"Zoran Jambor's weekly round-up. If you touch styling at all, this is how you stay current without becoming a CSS Twitter addict.",
