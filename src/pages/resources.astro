---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

/**
 * /resources — curated outbound links. The whole file is static data +
 * markup, zero scripts. Every link is to a source we recommend, with
 * `rel="noopener noreferrer"` + `target="_blank"` for safe cross-origin
 * navigation (same pattern established in #78 / #87 / #92).
 *
 * Legal posture (per issue #93): we don't scrape, we don't aggregate, we
 * don't cache content from these sources. We hyperlink. Fair use, no
 * copyright exposure, zero infra cost. If a future "news feed" slice
 * polls RSS, that'll be a separate issue with its own posture doc.
 *
 * Curation discipline: every link below has been chosen because it is
 *   (a) authoritative — the author / organisation IS the subject matter,
 *       not a secondary summary;
 *   (b) free to access — no paywall gate on the primary content;
 *   (c) durable — a site that has survived > 3 years and shows active
 *       maintenance (dates on content, working comment sections, etc.).
 * Removing a link because the source went stale is part of the ongoing
 * maintenance; adding links is a PR with the three-point rationale.
 */

interface ResourceLink {
	title: string;
	description: string;
	href: string;
	/** The host / brand, for attribution. */
	source: string;
}

interface ResourceSection {
	icon: string;
	title: string;
	intro: string;
	links: ResourceLink[];
}

const sections: ResourceSection[] = [
	{
		icon: '🧱',
		title: 'Code quality & best practices',
