const sectionCount = sections.length;
const linkCount = sections.reduce((acc, s) => acc + s.links.length, 0);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#00bcd4" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<SEO
			title="Resources — Learn to build secure, well-designed software | CodePals"
			description={`A curated list of ${linkCount}+ free resources across ${sectionCount} categories: code quality, architecture, DDD, security, testing, TDD, Playwright, AI development with LLMs, free courses, docs, news, and newsletters. Hand-picked for working developers.`}
			canonical="/resources"
		/>
	</head>
	<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
		<Header />

		<main class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
			<header class="mb-12">
				<h1 class="text-4xl sm:text-5xl font-bold text-slate-900 mb-4">
					Resources for working developers
				</h1>
				<p class="text-lg text-slate-700 max-w-3xl leading-relaxed mb-3">
					A hand-curated list of {linkCount}+ free resources across {sectionCount} categories. Code quality,
					architecture (incl. DDD), security, testing (incl. TDD + Playwright), AI development with LLMs,
					docs, courses, news, newsletters. Chosen because they're <strong>authoritative</strong> (the
					author IS the subject matter),
					<strong>free</strong> (no paywall on the primary content), and
					<strong>durable</strong> (they've survived &gt; 3 years and show active maintenance).
				</p>
				<p class="text-sm text-slate-600 max-w-3xl">
					Everything here is a link — we don't scrape or re-publish anyone else's writing. If you
					find a resource that belongs on this list, open an issue on
					<a
						href="https://github.com/rmjoia/codepalsio/issues/new"
						target="_blank"
						rel="noopener noreferrer"
						class="text-primary-600 hover:text-primary-700 underline">GitHub</a
					>.
				</p>
			</header>

			<nav
				aria-label="Jump to section"
				class="mb-12 bg-white rounded-xl shadow-sm border border-slate-200 p-5"
			>
				<p class="text-sm font-semibold text-slate-700 mb-2 uppercase tracking-wide">
					Jump to section
				</p>
				<ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
					{
						sections.map((s) => (
							<li>
								<a
									href={`#${s.title
										.toLowerCase()
										.replace(/[^a-z0-9]+/g, '-')
										.replace(/^-|-$/g, '')}`}
									class="text-primary-600 hover:text-primary-700 hover:underline"
								>
									{s.icon} {s.title}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			{
				sections.map((section) => {
					const sectionId = section.title
						.toLowerCase()
						.replace(/[^a-z0-9]+/g, '-')
						.replace(/^-|-$/g, '');
					return (
						<section id={sectionId} class="mb-14 scroll-mt-20">
							<header class="mb-5">
								<h2 class="text-2xl sm:text-3xl font-bold text-slate-900 flex items-center gap-3 mb-2">
									<span aria-hidden="true">{section.icon}</span>
									<span>{section.title}</span>
								</h2>
								<p class="text-slate-700 max-w-3xl">{section.intro}</p>
							</header>
							<ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
								{section.links.map((link) => (
									<li class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 hover:shadow-md hover:border-primary-200 transition-all">
										<a
											href={link.href}
											target="_blank"
											rel="noopener noreferrer"
											class="block group"
										>
											<h3 class="text-lg font-semibold text-slate-900 group-hover:text-primary-700 mb-1">
												{link.title}
												<span
													aria-hidden="true"
													class="inline-block ml-1 text-primary-500 group-hover:translate-x-0.5 transition-transform"
												>
													↗
												</span>
											</h3>
											<p class="text-sm text-slate-700 mb-2 leading-relaxed">{link.description}</p>
											<p class="text-xs text-slate-500 font-mono">{link.source}</p>
										</a>
									</li>
								))}
							</ul>
						</section>
					);
				})
			}

			<footer class="mt-16 pt-8 border-t border-slate-200 text-sm text-slate-600 max-w-3xl">
				<p class="mb-3">
					<strong>Found a dead link, or a resource that belongs here?</strong>
					Open an issue on
					<a
						href="https://github.com/rmjoia/codepalsio/issues/new"
						target="_blank"
						rel="noopener noreferrer"
						class="text-primary-600 hover:text-primary-700 underline">the repo</a
					> or submit a PR. We keep the list honest.
				</p>
				<p class="italic text-slate-500">
					Last reviewed: {new Date().toISOString().split('T')[0]} · Owned by the CodePals community.
				</p>
			</footer>
		</main>

		<Footer />
	</body>
</html>
