---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEO from '../../components/SEO.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#00bcd4" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<SEO
			title="Admin · CodePals"
			description="Administrative tools for CodePals moderators and managers."
			canonical="/admin"
			noindex={true}
		/>
	</head>
	<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
		<Header />

		<!-- Loading -->
		<div id="loading-state" class="flex justify-center items-center min-h-[60vh]">
			<div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-500"></div>
		</div>

		<!-- Forbidden (route gate fired) / error -->
		<div id="error-state" class="hidden mx-auto max-w-2xl px-4 py-16 text-center">
			<h1 id="error-title" class="text-2xl font-bold text-red-700 mb-2">
				Couldn't load admin view
			</h1>
			<p id="error-message" class="text-slate-600 mb-6">
				Something went wrong. Please refresh and try again.
			</p>
			<button
				id="admin-refresh-btn"
				class="px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
			>
				Refresh
			</button>
		</div>

		<main id="admin-main" class="hidden mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
			<div class="mb-8">
				<h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-2">Admin</h1>
				<p class="text-slate-600">
					Moderation view: profile completeness + visibility across the community.
				</p>
			</div>

			<!-- KPI cards -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				<div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200">
					<p class="text-xs uppercase tracking-wide text-slate-500 mb-1">Total profiles</p>
					<p id="kpi-total" class="text-3xl font-bold text-slate-900">—</p>
				</div>
				<div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200">
					<p class="text-xs uppercase tracking-wide text-slate-500 mb-1">Public</p>
					<p id="kpi-public" class="text-3xl font-bold text-green-700">—</p>
				</div>
				<div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200">
					<p class="text-xs uppercase tracking-wide text-slate-500 mb-1">Private</p>
					<p id="kpi-private" class="text-3xl font-bold text-slate-700">—</p>
				</div>
				<div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200">
					<p class="text-xs uppercase tracking-wide text-slate-500 mb-1">Complete</p>
					<p id="kpi-complete" class="text-3xl font-bold text-primary-600">—</p>
				</div>
			</div>

			<!-- GitHub Issues stat tile. Fetched client-side from the public
				 GitHub REST API (no auth, 60/hr rate limit per IP — more than
				 enough for the admin viewer count). Cached 5 min in
				 localStorage so a page reload doesn't burn a request. Lives
				 next to the profile KPIs because the admin glances here for
				 "anything new to triage?" and GitHub Issues is the user-help
				 channel (see .github/ISSUE_TEMPLATE/user-help.yml). -->
			<div class="mb-8">
				<a
					id="github-issues-tile"
					href="https://github.com/rmjoia/codepalsio/issues?q=is%3Aopen+is%3Aissue"
					target="_blank"
					rel="noopener noreferrer"
					class="block bg-white rounded-xl p-5 shadow-sm border border-slate-200 hover:border-primary-400 hover:shadow transition-all"
				>
					<div class="flex items-center justify-between">
						<div>
							<p class="text-xs uppercase tracking-wide text-slate-500 mb-1">Open GitHub issues</p>
							<p id="kpi-open-issues" class="text-3xl font-bold text-slate-900">—</p>
							<p id="kpi-open-issues-note" class="text-xs text-slate-400 mt-1">
								Checking github.com…
							</p>
						</div>
						<svg
							class="w-10 h-10 text-slate-300"
							fill="currentColor"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.56v-2.17c-3.19.69-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.79.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"
							></path>
						</svg>
					</div>
				</a>
			</div>

			<!-- Manage admins -->
			<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden mb-8">
				<div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between">
					<div>
						<h2 class="font-semibold text-slate-900">Manage admins</h2>
						<p class="text-xs text-slate-500 mt-0.5">
							Add or remove admin access by GitHub username. The first admin is bootstrapped from
							the <code class="text-xs">ADMIN_GITHUB_LOGINS</code> env var; from then on this list is
							the source of truth.
						</p>
					</div>
				</div>
				<form
					id="admin-grant-form"
					class="px-5 py-4 border-b border-slate-200 flex items-end gap-3"
				>
					<div class="flex-1">
						<label for="admin-grant-input" class="block text-xs font-medium text-slate-700 mb-1">
							GitHub username
						</label>
						<input
							id="admin-grant-input"
							type="text"
							required
							placeholder="e.g. octocat"
							autocomplete="off"
							class="w-full px-3 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
						/>
					</div>
					<button
						type="submit"
						id="admin-grant-submit"
						class="px-4 py-2 bg-primary-500 text-white text-sm font-medium rounded-md hover:bg-primary-600 transition-colors"
					>
						Grant admin
					</button>
				</form>
				<p id="admin-grant-status" class="hidden px-5 py-2 text-xs"></p>
				<div class="overflow-x-auto">
					<table class="w-full text-sm">
						<thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
							<tr>
								<th class="text-left px-5 py-3 font-medium">GitHub</th>
								<th class="text-left px-5 py-3 font-medium">Granted by</th>
								<th class="text-left px-5 py-3 font-medium">Granted at</th>
								<th class="text-right px-5 py-3 font-medium">Actions</th>
							</tr>
						</thead>
						<tbody id="admins-tbody" class="divide-y divide-slate-100"></tbody>
					</table>
				</div>
				<div id="admins-empty" class="hidden p-8 text-center text-slate-500 text-sm">
					No admins yet — add one above.
				</div>
			</div>

			<!-- Users table -->
			<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
				<div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between">
					<h2 class="font-semibold text-slate-900">Users</h2>
					<span id="users-count" class="text-sm text-slate-500"></span>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-sm">
						<thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
							<tr>
								<th class="text-left px-5 py-3 font-medium">Display name</th>
								<th class="text-left px-5 py-3 font-medium">GitHub</th>
								<th class="text-left px-5 py-3 font-medium">Visibility</th>
								<th class="text-left px-5 py-3 font-medium">Availability</th>
								<th class="text-left px-5 py-3 font-medium">Completeness</th>
								<th class="text-left px-5 py-3 font-medium">Updated</th>
							</tr>
						</thead>
						<tbody id="users-tbody" class="divide-y divide-slate-100"></tbody>
					</table>
				</div>
				<div id="users-empty" class="hidden p-8 text-center text-slate-500 text-sm">
					No profiles yet.
				</div>
			</div>
		</main>

		<Footer />

		<script>
			import {
				getAdminUsers,
				listAdmins,
				grantAdmin,
				revokeAdmin,
				ApiError,
				type AdminProfileRow,
				type AdminListEntry,
			} from '../../services/api';

			function setText(id: string, value: string | number): void {
				const el = document.getElementById(id);
				if (el) el.textContent = String(value);
			}

			/**
			 * Read the open-issue count from the public GitHub REST API and
			 * paint it onto the admin stat tile. Soft-fails on any error so
			 * a flaky GitHub never breaks /admin.
			 *
			 * Cached 5 min in localStorage so an admin refreshing the page
			 * doesn't burn a request against the unauthenticated API's
			 * 60/hr/IP ceiling. The cache key includes the API path so a
			 * future repo rename flushes stale counts automatically.
			 *
			 * The repository endpoint returns `open_issues_count` which
			 * includes BOTH issues and pull requests — fine for the
			 * "anything new to triage?" glance; a dedicated search would
			 * be more accurate but costs a round trip for a small win.
			 */
			async function loadOpenIssueCount(): Promise<void> {
				const tile = document.getElementById('github-issues-tile');
				const countEl = document.getElementById('kpi-open-issues');
				const noteEl = document.getElementById('kpi-open-issues-note');
				if (!tile || !countEl || !noteEl) return;

				const CACHE_KEY = 'codepals.admin.github.open_issues_count';
				const CACHE_TTL_MS = 5 * 60 * 1000;

				// Serve from cache first for an instant paint; still kick off
				// the refresh so the number stays live within the TTL.
				try {
					const raw = localStorage.getItem(CACHE_KEY);
					if (raw) {
						const parsed = JSON.parse(raw) as { count: number; at: number };
						if (Date.now() - parsed.at < CACHE_TTL_MS) {
							countEl.textContent = String(parsed.count);
							noteEl.textContent = 'cached — refreshes every 5 min';
							return;
						}
					}
				} catch {
					// Private window / disabled storage → no cache. Fall through.
				}

				try {
					const res = await fetch('https://api.github.com/repos/rmjoia/codepalsio', {
						headers: { Accept: 'application/vnd.github+json' },
					});
					if (!res.ok) throw new Error(`github ${res.status}`);
					const body = (await res.json()) as { open_issues_count?: number };
					const count = typeof body.open_issues_count === 'number' ? body.open_issues_count : 0;
					countEl.textContent = String(count);
					noteEl.textContent = `issues + PRs · updated ${new Date().toLocaleTimeString()}`;
					try {
						localStorage.setItem(CACHE_KEY, JSON.stringify({ count, at: Date.now() }));
					} catch {
						// Non-fatal — the count is still painted for this view.
					}
				} catch (err) {
					// Keep the dash; replace the note with a soft error.
					noteEl.textContent = 'Couldn’t reach github.com — click to view';
					console.warn('github issue count fetch failed:', err);
				}
			}

			function badge(text: string, cls: string): HTMLElement {
				const span = document.createElement('span');
				span.className = `inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-full ${cls}`;
				span.textContent = text;
				return span;
			}

			function visibilityBadge(v: AdminProfileRow['profileVisibility']): HTMLElement {
				return v === 'public'
					? badge('🌍 Public', 'bg-green-100 text-green-700')
					: badge('🔒 Private', 'bg-slate-100 text-slate-600');
			}

			function availabilityBadge(a: AdminProfileRow['availability']): HTMLElement {
				switch (a) {
					case 'active':
						return badge('Active', 'bg-green-100 text-green-700');
					case 'casual':
						return badge('Casual', 'bg-amber-100 text-amber-700');
					case 'unavailable':
						return badge('Unavailable', 'bg-slate-100 text-slate-600');
					default:
						return badge('Unknown', 'bg-slate-100 text-slate-600');
				}
			}

			function completenessCell(row: AdminProfileRow): HTMLElement {
				const wrap = document.createElement('div');
				wrap.className = 'flex items-center gap-2';
				wrap.appendChild(
					badge(
						row.complete ? 'Complete' : 'Incomplete',
						row.complete ? 'bg-primary-100 text-primary-700' : 'bg-amber-100 text-amber-700'
					)
				);
				const detail = document.createElement('span');
				detail.className = 'text-xs text-slate-500';
				const parts: string[] = [];
				if (row.bioLength < 50) parts.push(`bio ${row.bioLength}/50`);
				if (row.skillsCount < 2) parts.push(`skills ${row.skillsCount}/2`);
				if (row.interestsCount < 2) parts.push(`interests ${row.interestsCount}/2`);
				if (!row.hasLocation) parts.push('no location');
				if (!row.hasTimezone) parts.push('no timezone');
				detail.textContent = parts.length > 0 ? `(${parts.join(', ')})` : '';
				wrap.appendChild(detail);
				return wrap;
			}

			function formatUpdatedAt(iso: string | undefined): string {
				if (!iso) return '—';
				const d = new Date(iso);
				if (isNaN(d.getTime())) return iso;
				return d.toISOString().slice(0, 10);
			}

			function buildRow(row: AdminProfileRow): HTMLTableRowElement {
				const tr = document.createElement('tr');
				tr.className = 'hover:bg-slate-50';

				const td = (cls = 'px-5 py-3') => {
					const c = document.createElement('td');
					c.className = cls;
					return c;
				};

				const nameCell = td();
				nameCell.className = 'px-5 py-3 font-medium text-slate-900';
				nameCell.textContent = row.displayName;
				tr.appendChild(nameCell);

				const ghCell = td('px-5 py-3 text-slate-600');
				if (row.githubUsername) {
					const a = document.createElement('a');
					a.href = `https://github.com/${encodeURIComponent(row.githubUsername)}`;
					a.target = '_blank';
					a.rel = 'noopener noreferrer';
					a.className = 'hover:underline';
					a.textContent = '@' + row.githubUsername;
					ghCell.appendChild(a);
				} else {
					ghCell.textContent = '—';
				}
				tr.appendChild(ghCell);

				const visCell = td();
				visCell.appendChild(visibilityBadge(row.profileVisibility));
				tr.appendChild(visCell);

				const availCell = td();
				availCell.appendChild(availabilityBadge(row.availability));
				tr.appendChild(availCell);

				const completeCell = td();
				completeCell.appendChild(completenessCell(row));
				tr.appendChild(completeCell);

				const dateCell = td('px-5 py-3 text-slate-500 whitespace-nowrap');
				dateCell.textContent = formatUpdatedAt(row.updatedAt);
				tr.appendChild(dateCell);

				return tr;
			}

			async function init(): Promise<boolean> {
				const loading = document.getElementById('loading-state');
				const main = document.getElementById('admin-main');
				const errorState = document.getElementById('error-state');
				const errorTitle = document.getElementById('error-title');
				const errorMessage = document.getElementById('error-message');
				const tbody = document.getElementById('users-tbody');
				const empty = document.getElementById('users-empty');

				// Fire the GitHub open-issue count fetch in parallel — it's
				// a public read with no auth, so no need to serialise with
				// the admin KPI fetch. Soft-fail on any error (we just
				// show a dash); we don't want a flaky GitHub to break the
				// whole admin page.
				void loadOpenIssueCount();

				try {
					const { profiles, kpis } = await getAdminUsers();

					setText('kpi-total', kpis.totalProfiles);
					setText('kpi-public', kpis.publicProfiles);
					setText('kpi-private', kpis.privateProfiles);
					setText('kpi-complete', kpis.completeProfiles);
					setText(
						'users-count',
						`${profiles.length} ${profiles.length === 1 ? 'profile' : 'profiles'}`
					);

					if (tbody) {
						tbody.replaceChildren();
						profiles.forEach((p) => tbody.appendChild(buildRow(p)));
					}

					if (profiles.length === 0) empty?.classList.remove('hidden');

					loading?.classList.add('hidden');
					main?.classList.remove('hidden');
					return true;
				} catch (err) {
					console.error('admin init failed:', err);
					if (err instanceof ApiError) {
						if (err.status === 403) {
							if (errorTitle) errorTitle.textContent = 'Forbidden';
							if (errorMessage)
								errorMessage.textContent =
									"You don't have the admin role. Ask the operator to add your GitHub login to ADMIN_GITHUB_LOGINS, then sign out and back in.";
						} else if (err.status === 401) {
							if (errorTitle) errorTitle.textContent = 'Sign in required';
							if (errorMessage)
								errorMessage.textContent = 'Please sign in to access the admin view.';
						}
					}
					loading?.classList.add('hidden');
					errorState?.classList.remove('hidden');
					return false;
				}
			}

			// ─── Manage admins section ──────────────────────────────────────

			function formatDate(iso: string | undefined): string {
				if (!iso) return '—';
				const d = new Date(iso);
				return isNaN(d.getTime()) ? iso : d.toISOString().slice(0, 10);
			}

			function showGrantStatus(message: string, kind: 'ok' | 'error'): void {
				const el = document.getElementById('admin-grant-status');
				if (!el) return;
				el.textContent = message;
				el.className =
					kind === 'ok'
						? 'px-5 py-2 text-xs text-green-700 bg-green-50'
						: 'px-5 py-2 text-xs text-red-700 bg-red-50';
				el.classList.remove('hidden');
			}

			function hideGrantStatus(): void {
				document.getElementById('admin-grant-status')?.classList.add('hidden');
			}

			function buildAdminRow(entry: AdminListEntry): HTMLTableRowElement {
				const tr = document.createElement('tr');
				tr.className = 'hover:bg-slate-50';

				const ghCell = document.createElement('td');
				ghCell.className = 'px-5 py-3 font-medium text-slate-900';
				const a = document.createElement('a');
				a.href = `https://github.com/${encodeURIComponent(entry.githubUsername)}`;
				a.target = '_blank';
				a.rel = 'noopener noreferrer';
				a.className = 'hover:underline';
				a.textContent = '@' + entry.githubUsername;
				ghCell.appendChild(a);
				tr.appendChild(ghCell);

				const granterCell = document.createElement('td');
				granterCell.className = 'px-5 py-3 text-slate-600';
				granterCell.textContent = entry.grantedBy ?? '—';
				tr.appendChild(granterCell);

				const dateCell = document.createElement('td');
				dateCell.className = 'px-5 py-3 text-slate-500 whitespace-nowrap';
				dateCell.textContent = formatDate(entry.grantedAt);
				tr.appendChild(dateCell);

				const actionsCell = document.createElement('td');
				actionsCell.className = 'px-5 py-3 text-right';
				const revokeBtn = document.createElement('button');
				revokeBtn.type = 'button';
				revokeBtn.className =
					'text-xs font-medium px-3 py-1.5 rounded-md text-red-700 hover:bg-red-50 border border-red-200';
				revokeBtn.textContent = 'Revoke';
				revokeBtn.addEventListener('click', () => onRevokeClick(entry.githubUsername));
				actionsCell.appendChild(revokeBtn);
				tr.appendChild(actionsCell);

				return tr;
			}

			async function refreshAdminsList(): Promise<void> {
				const tbody = document.getElementById('admins-tbody');
				const empty = document.getElementById('admins-empty');
				if (!tbody || !empty) return;
				try {
					const admins = await listAdmins();
					tbody.replaceChildren();
					admins.forEach((a) => tbody.appendChild(buildAdminRow(a)));
					empty.classList.toggle('hidden', admins.length > 0);
				} catch (err) {
					console.error('admins list failed:', err);
					showGrantStatus('Failed to load admins list.', 'error');
				}
			}

			async function onGrantSubmit(e: SubmitEvent): Promise<void> {
				e.preventDefault();
				const input = document.getElementById('admin-grant-input') as HTMLInputElement | null;
				const submit = document.getElementById('admin-grant-submit') as HTMLButtonElement | null;
				if (!input || !submit) return;
				const username = input.value.trim();
				if (!username) return;

				submit.disabled = true;
				hideGrantStatus();
				try {
					await grantAdmin(username);
					input.value = '';
					showGrantStatus(`@${username} is now an admin.`, 'ok');
					await refreshAdminsList();
				} catch (err) {
					if (err instanceof ApiError) {
						const msg =
							typeof err.body === 'object' && err.body && 'error' in err.body
								? String((err.body as { error: unknown }).error)
								: `Request failed (${err.status})`;
						showGrantStatus(msg, 'error');
					} else {
						showGrantStatus('Network error — try again.', 'error');
					}
				} finally {
					submit.disabled = false;
				}
			}

			async function onRevokeClick(username: string): Promise<void> {
				if (!confirm(`Revoke admin access for @${username}?`)) return;
				hideGrantStatus();
				try {
					await revokeAdmin(username);
					showGrantStatus(`Revoked admin access for @${username}.`, 'ok');
					await refreshAdminsList();
				} catch (err) {
					if (err instanceof ApiError) {
						const msg =
							typeof err.body === 'object' && err.body && 'error' in err.body
								? String((err.body as { error: unknown }).error)
								: `Revoke failed (${err.status})`;
						showGrantStatus(msg, 'error');
					} else {
						showGrantStatus('Network error — try again.', 'error');
					}
				}
			}

			document.getElementById('admin-grant-form')?.addEventListener('submit', onGrantSubmit);
			document
				.getElementById('admin-refresh-btn')
				?.addEventListener('click', () => window.location.reload());

			// Only fetch the admins list if the main admin view actually loaded
			// (avoids an extra failing request + console noise on 401/403).
			init().then((ok) => {
				if (ok) refreshAdminsList();
			});
		</script>
	</body>
</html>
