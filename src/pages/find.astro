---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#00bcd4" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<SEO
			title="Find CodePals — Discover the community"
			description="Browse public profiles in the CodePals community. Find developers to pair with, learn from, or mentor."
			canonical="/find"
			noindex={true}
		/>
	</head>
	<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
		<Header />

		<!-- Loading -->
		<div id="loading-state" class="flex justify-center items-center min-h-[60vh]">
			<div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-500"></div>
		</div>

		<!-- Error -->
		<div id="error-state" class="hidden mx-auto max-w-2xl px-4 py-16 text-center">
			<h1 class="text-2xl font-bold text-red-700 mb-2">Couldn't load the directory</h1>
			<p class="text-slate-600 mb-6">
				Something went wrong. Please refresh the page and try again.
			</p>
			<button
				id="directory-refresh-btn"
				class="px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
			>
				Refresh
			</button>
		</div>

		<!-- Directory -->
		<main id="directory-main" class="hidden mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
			<div class="mb-8">
				<h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-2">Find CodePals</h1>
				<!--
					Two state-aware banners; both start `hidden` to avoid the
					"wrong message flashes briefly" pattern (same lesson as
					Header.astro's skeleton). The init() script picks one
					once it has resolved (a) the directory data and (b) the
					caller's principal. If the directory is empty the
					empty-state card replaces both, so neither banner is
					shown — the empty-state copy already covers the call to
					action.
				-->
				<p id="banner-not-listed" class="hidden text-slate-600">
					Browse public profiles in the CodePals community. Want to be listed?
					<a href="/profile?edit=true" class="text-primary-500 hover:underline"
						>Make your profile public</a
					>
					in your profile settings.
				</p>
				<p id="banner-listed" class="hidden text-slate-600">
					Browse public profiles in the CodePals community. <span class="font-medium text-slate-700"
						>You're listed</span
					> — <a href="/profile?edit=true" class="text-primary-500 hover:underline"
						>edit your profile</a
					> to update what others see.
				</p>
			</div>

			<!-- Search box. Debounced client-side; fires a fresh /api/profiles?q=
				 request so the matching happens against ALL public profiles,
				 not just the already-loaded page. -->
			<div class="mb-8">
				<label for="directory-search" class="sr-only">Search CodePals</label>
				<div class="relative">
					<svg
						class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1 0 6 6a7.5 7.5 0 0 0 10.65 10.65z"></path>
					</svg>
					<input
						type="search"
						id="directory-search"
						placeholder="Search by name, skill, bio, or what someone's working on…"
						autocomplete="off"
						maxlength="100"
						class="w-full pl-10 pr-4 py-3 bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
					/>
				</div>
				<p id="search-help" class="mt-2 text-xs text-slate-500">
					Tip: try a project name, language, or something like "need help with React".
				</p>
			</div>

			<!-- Empty state (no public profiles yet) -->
			<div
				id="empty-state"
				class="hidden bg-white rounded-2xl shadow-sm border border-slate-200 p-12 text-center"
			>
				<div class="text-5xl mb-4">🌱</div>
				<h2 class="text-xl font-bold text-slate-900 mb-2">No public profiles yet</h2>
				<p class="text-slate-600 mb-6">
					Be the first! Make your profile public so other CodePals can find you.
				</p>
				<a
					href="/profile?edit=true"
					class="inline-flex items-center gap-2 px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
				>
					Edit my profile
				</a>
			</div>

			<!-- No-results state (search returned zero rows). Distinct from
				 empty-state so the copy makes sense: there ARE public profiles,
				 just none matching this query. -->
			<div
				id="no-results-state"
				class="hidden bg-white rounded-2xl shadow-sm border border-slate-200 p-12 text-center"
			>
				<div class="text-5xl mb-4">🔎</div>
				<h2 class="text-xl font-bold text-slate-900 mb-2">No CodePals match that search</h2>
				<p class="text-slate-600 mb-6">
					Try a broader word, or clear the search to browse everyone.
				</p>
				<button
					id="no-results-clear-btn"
					class="inline-flex items-center gap-2 px-4 py-2 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors"
				>
					Clear search
				</button>
			</div>

			<!-- Card grid -->
			<div id="directory-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
			</div>
		</main>

		<Footer />

		<script>
			import {
				getPrincipal,
				getPublicProfiles,
				getProfileAvatarUrl,
				type DirectoryProfile,
			} from '../services/api';

			/**
			 * Did the caller find themselves in the directory rows?
			 *
			 * The directory query was changed in PR #51 to include the
			 * caller's own row (self-preview), so we can decide listed-ness
			 * by simple row match instead of a second API call to
			 * /api/profile-get. Match is case-insensitive: github stores
			 * the canonical case but defensive normalisation is cheap and
			 * insulates against future drift if principal.userDetails ever
			 * arrives with different casing.
			 */
			function isSelfListed(profiles: DirectoryProfile[], githubLogin: string | null): boolean {
				if (!githubLogin) return false;
				const needle = githubLogin.toLowerCase();
				return profiles.some((p) => (p.githubUsername ?? '').toLowerCase() === needle);
			}

			function availabilityBadge(availability: DirectoryProfile['availability']): {
				label: string;
				cls: string;
			} {
				switch (availability) {
					case 'active':
						return { label: '🟢 Active', cls: 'bg-green-100 text-green-700' };
					case 'casual':
						return { label: '🟡 Casual', cls: 'bg-amber-100 text-amber-700' };
					case 'unavailable':
						return { label: '⚪ Not available', cls: 'bg-slate-100 text-slate-600' };
					default:
						// Defensive: future enum value or corrupt data shouldn't throw
						// downstream on `.cls` access. Render a neutral fallback.
						return { label: '⚪ Unknown', cls: 'bg-slate-100 text-slate-600' };
				}
			}

			function buildCard(profile: DirectoryProfile): HTMLElement {
				// Card is a link to the (future) profile detail page. Today the URL
				// 404s — that's intentional placeholder behavior; when /find/[user]
				// lands, the link starts working without touching this code.
				const card = document.createElement('a');
				card.href = profile.githubUsername
					? `/find/${encodeURIComponent(profile.githubUsername)}`
					: `/find/${encodeURIComponent(profile.id)}`;
				card.className =
					'bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col hover:shadow-md transition-shadow no-underline text-current focus:outline-none focus:ring-2 focus:ring-primary-500';

				// Header row: avatar + name
				const header = document.createElement('div');
				header.className = 'flex items-center gap-3 mb-4';

				const avatarUrl = getProfileAvatarUrl(profile);
				if (avatarUrl) {
					const img = document.createElement('img');
					img.src = avatarUrl;
					img.alt = profile.displayName;
					img.className = 'w-12 h-12 rounded-full border-2 border-primary-100 flex-shrink-0';
					header.appendChild(img);
				} else {
					const placeholder = document.createElement('div');
					placeholder.className =
						'w-12 h-12 rounded-full bg-primary-500 text-white flex items-center justify-center font-semibold flex-shrink-0';
					placeholder.textContent = (profile.displayName || '?').charAt(0).toUpperCase();
					header.appendChild(placeholder);
				}

				const nameWrap = document.createElement('div');
				nameWrap.className = 'min-w-0';
				const name = document.createElement('h3');
				name.className = 'font-semibold text-slate-900 truncate';
				name.textContent = profile.displayName;
				nameWrap.appendChild(name);
				// Display the @githubUsername handle ONLY when the owner has
				// explicitly set their githubUrl in the profile form. Showing
				// the handle derived from the OAuth login — which every
				// signed-in user has — would publish their GitHub identity
				// without consent. Explicit opt-in is the GDPR Article 25
				// ("by default") gate; the githubUrl field is that opt-in.
				if (profile.githubUsername && profile.githubUrl) {
					const handle = document.createElement('p');
					handle.className = 'text-xs text-slate-500 truncate';
					handle.textContent = '@' + profile.githubUsername;
					nameWrap.appendChild(handle);
				}
				header.appendChild(nameWrap);

				const avail = availabilityBadge(profile.availability);
				const availSpan = document.createElement('span');
				availSpan.className = `ml-auto text-xs font-medium px-2 py-0.5 rounded-full whitespace-nowrap ${avail.cls}`;
				availSpan.textContent = avail.label;
				header.appendChild(availSpan);

				card.appendChild(header);

				// Bio — optional now that per-field visibility can strip it
				// from non-owners; only render the element when content exists.
				if (profile.bio) {
					const bio = document.createElement('p');
					bio.className = 'text-sm text-slate-700 mb-4 line-clamp-3';
					bio.textContent = profile.bio;
					card.appendChild(bio);
				}

				// "What are you working on?" — the D5 signal. Rendered as a
				// quoted paragraph with a leading dash so it stands out from
				// the bio typographically without needing a labelled row.
				// Truncated via line-clamp-2 so very long entries don't
				// stretch the card.
				if (profile.lookingFor) {
					const lf = document.createElement('p');
					lf.className =
						'text-sm text-primary-700 bg-primary-50 border-l-2 border-primary-400 px-3 py-2 rounded-r mb-3 line-clamp-2 italic';
					lf.textContent = profile.lookingFor;
					card.appendChild(lf);
				}

				// Skills (cap at 5 chips, +N more if over). Optional under
				// per-field visibility — guard against the absent case.
				const skillsList = profile.skills ?? [];
				if (skillsList.length > 0) {
					const skills = document.createElement('div');
					skills.className = 'flex flex-wrap gap-1.5 mb-3';
					skillsList.slice(0, 5).forEach((skill) => {
						const chip = document.createElement('span');
						chip.className = 'px-2 py-0.5 text-xs bg-primary-50 text-primary-700 rounded-full';
						chip.textContent = skill;
						skills.appendChild(chip);
					});
					if (skillsList.length > 5) {
						const more = document.createElement('span');
						more.className = 'px-2 py-0.5 text-xs text-slate-500';
						more.textContent = `+${skillsList.length - 5} more`;
						skills.appendChild(more);
					}
					card.appendChild(skills);
				}

				// Languages — a key "can we talk?" signal on the card.
				// Rendered as neutral slate chips so skills (primary) stay
				// the visually dominant row. Cap at 3 — this is a card, not
				// a profile page; viewers drill in to see the full list.
				// No prefix label: the chip text (English, Português, …) is
				// self-explanatory, same as the skills row above.
				const langsList = profile.preferredLanguages ?? [];
				if (langsList.length > 0) {
					const langs = document.createElement('div');
					langs.className = 'flex flex-wrap gap-1.5 mb-3';
					langsList.slice(0, 3).forEach((lang) => {
						const chip = document.createElement('span');
						chip.className = 'px-2 py-0.5 text-xs bg-slate-100 text-slate-700 rounded-full';
						chip.textContent = lang;
						langs.appendChild(chip);
					});
					if (langsList.length > 3) {
						const more = document.createElement('span');
						more.className = 'px-2 py-0.5 text-xs text-slate-500';
						more.textContent = `+${langsList.length - 3} more`;
						langs.appendChild(more);
					}
					card.appendChild(langs);
				}

				// Footer: location + timezone
				const meta: string[] = [];
				if (profile.location) meta.push(profile.location);
				if (profile.timezone) meta.push(profile.timezone);
				if (meta.length > 0) {
					const footer = document.createElement('p');
					footer.className = 'mt-auto text-xs text-slate-500 pt-3 border-t border-slate-100';
					footer.textContent = meta.join(' · ');
					card.appendChild(footer);
				}

				return card;
			}

			// Caller's own userDetails, resolved once at init and reused on
			// every re-render so the listed-banner state stays stable
			// across searches.
			let viewerLogin: string | null = null;

			function renderResults(profiles: DirectoryProfile[], query: string): void {
				const grid = document.getElementById('directory-grid');
				const empty = document.getElementById('empty-state');
				const noResults = document.getElementById('no-results-state');
				const bannerListed = document.getElementById('banner-listed');
				const bannerNotListed = document.getElementById('banner-not-listed');

				// Reset all state before painting.
				grid?.classList.add('hidden');
				empty?.classList.add('hidden');
				noResults?.classList.add('hidden');
				if (grid) grid.innerHTML = '';
				bannerListed?.classList.add('hidden');
				bannerNotListed?.classList.add('hidden');

				if (profiles.length === 0) {
					// Zero rows: different message depending on whether the
					// query was empty (no public profiles exist yet) vs a
					// filter that matched nothing (profiles exist but none
					// match).
					if (query.trim()) {
						noResults?.classList.remove('hidden');
					} else {
						empty?.classList.remove('hidden');
					}
					return;
				}

				// Pick the banner that matches the caller's listed-ness.
				// Only shown on the unfiltered view — "You're listed" is
				// confusing when you've just narrowed to profiles that
				// don't include you.
				if (!query.trim()) {
					const listed = isSelfListed(profiles, viewerLogin);
					(listed ? bannerListed : bannerNotListed)?.classList.remove('hidden');
				}

				if (grid) {
					profiles.forEach((p) => grid.appendChild(buildCard(p)));
					grid.classList.remove('hidden');
				}
			}

			async function runSearch(query: string): Promise<void> {
				const grid = document.getElementById('directory-grid');
				// Fade existing content slightly instead of blanking so the
				// search feels responsive even on a slow network.
				if (grid) grid.style.opacity = '0.5';
				try {
					const profiles = await getPublicProfiles(query);
					renderResults(profiles, query);
				} catch (err) {
					console.error('Directory search failed:', err);
					const error = document.getElementById('error-state');
					document.getElementById('loading-state')?.classList.add('hidden');
					document.getElementById('directory-main')?.classList.add('hidden');
					error?.classList.remove('hidden');
				} finally {
					if (grid) grid.style.opacity = '';
				}
			}

			// Debounce the search input so we don't fire a network request on
			// every keystroke. 250ms matches the "feels responsive but doesn't
			// hammer the server" sweet spot — short enough that typing a
			// 10-char query hits the API ~once, not 10 times.
			let debounceHandle: ReturnType<typeof setTimeout> | null = null;
			function scheduleSearch(query: string): void {
				if (debounceHandle !== null) clearTimeout(debounceHandle);
				debounceHandle = setTimeout(() => void runSearch(query), 250);
			}

			async function init() {
				const loading = document.getElementById('loading-state');
				const error = document.getElementById('error-state');
				const main = document.getElementById('directory-main');

				try {
					// Kick off both fetches in parallel — they're independent
					// and we need the answers from both before deciding which
					// banner to reveal. getPrincipal() is memoised at module
					// scope, so this doesn't add a second /.auth/me round
					// trip if any other component already asked.
					const [profiles, principal] = await Promise.all([getPublicProfiles(), getPrincipal()]);
					viewerLogin = principal?.userDetails ?? null;

					loading?.classList.add('hidden');
					main?.classList.remove('hidden');

					renderResults(profiles, '');
				} catch (err) {
					console.error('Directory load failed:', err);
					loading?.classList.add('hidden');
					error?.classList.remove('hidden');
				}
			}

			document
				.getElementById('directory-refresh-btn')
				?.addEventListener('click', () => window.location.reload());

			document.getElementById('directory-search')?.addEventListener('input', (e) => {
				scheduleSearch((e.target as HTMLInputElement).value);
			});

			document.getElementById('no-results-clear-btn')?.addEventListener('click', () => {
				const searchEl = document.getElementById('directory-search') as HTMLInputElement | null;
				if (searchEl) searchEl.value = '';
				void runSearch('');
			});

			init();
		</script>
	</body>
</html>
